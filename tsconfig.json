{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "es2018",
    "allowJs": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "jest"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/ui/*": [
        "./components/ui/*"
      ],
      "@components/*": [
        "./components/*"
      ],
      "/*": [
        "./public/*"
      ],
      "@matrx/agents": [
        "./packages/matrx-agents/src/index.ts"
      ],
      "@matrx/agents/adapters": [
        "./packages/matrx-agents/src/adapters/index.ts"
      ],
      "@matrx/agents/config": [
        "./packages/matrx-agents/src/config/index.ts"
      ],
      "@matrx/agents/types": [
        "./packages/matrx-agents/src/types/index.ts"
      ]
    },
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowUnreachableCode": false,
    "noErrorTruncation": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "forceConsistentCasingInFileNames": false,
    "strictBindCallApply": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "tests/**/*",
    "scripts/**/*",
    "node_modules/flowbite-react/lib/esm/index.d.ts",
    "global.d.ts",
    "cartesia.d.ts",
    "components/**/*",
    "features/**/*",
    "app/**/*",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-preview-qa2/types/**/*.ts",
    ".next-preview-qa2/dev/types/**/*.ts",
    ".next-preview-cutoverqa/types/**/*.ts",
    ".next-preview-cutoverqa/dev/types/**/*.ts",
    ".next-preview-qa3/types/**/*.ts",
    ".next-preview-qa3/dev/types/**/*.ts",
    ".next-agent-testsessiona/types/**/*.ts",
    ".next-agent-testsessiona/dev/types/**/*.ts",
    ".next-agent-warmtestxyz7/types/**/*.ts",
    ".next-agent-warmtestxyz7/dev/types/**/*.ts",
    ".next-agent-4520de53e695/types/**/*.ts",
    ".next-agent-4520de53e695/dev/types/**/*.ts",
    ".next-agent-4610a8e240c6/types/**/*.ts",
    ".next-agent-4610a8e240c6/dev/types/**/*.ts",
    ".next-agent-6a1549e8d6a0/types/**/*.ts",
    ".next-agent-6a1549e8d6a0/dev/types/**/*.ts",
    ".next-agent-89c5b518e328/types/**/*.ts",
    ".next-agent-89c5b518e328/dev/types/**/*.ts",
    ".next-agent-fd54c243c80b/types/**/*.ts",
    ".next-agent-fd54c243c80b/dev/types/**/*.ts",
    ".next-agent-11014e34545f/types/**/*.ts",
    ".next-agent-11014e34545f/dev/types/**/*.ts",
    ".next-agent-4b70848fdb24/types/**/*.ts",
    ".next-agent-4b70848fdb24/dev/types/**/*.ts",
    ".next-agent-ae2be49aed4e/types/**/*.ts",
    ".next-agent-ae2be49aed4e/dev/types/**/*.ts",
    ".next-agent-cdc4ea4727a9/types/**/*.ts",
    ".next-agent-cdc4ea4727a9/dev/types/**/*.ts",
    ".next-agent-2fdc556864ac/types/**/*.ts",
    ".next-agent-2fdc556864ac/dev/types/**/*.ts"
  ],
  "exclude": [
    ".next*/**",
    ".next*",
    ".next",
    "node_modules",
    "_armani",
    "_dev",
    ".claude",
    "out",
    "utils/schema/schemaUtils.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ],
    "transpileOnly": true,
    "compilerOptions": {
      "ignoreDeprecations": "6.0",
      "rootDir": ".",
      "types": [
        "node"
      ],
      "lib": [
        "dom",
        "dom.iterable",
        "esnext"
      ],
      "module": "commonjs",
      "moduleResolution": "node",
      "baseUrl": ".",
      "paths": {
        "@/*": [
          "./*"
        ],
        "@components/ui/*": [
          "./components/ui/*"
        ],
        "@components/*": [
          "./components/*"
        ]
      }
    }
  }
}
