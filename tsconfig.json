{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "es2018",
    "allowJs": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "jest"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/ui/*": [
        "./components/ui/*"
      ],
      "@components/*": [
        "./components/*"
      ],
      "/*": [
        "./public/*"
      ],
      "@matrx/agents/config": [
        "./packages/matrx-agents/src/config/registry.ts"
      ],
      "@matrx/agents/build-reducer-map": [
        "./packages/matrx-agents/src/build-reducer-map.ts"
      ],
      "@matrx/agents/redux/*": [
        "./packages/matrx-agents/src/redux/*"
      ],
      "@matrx/agents/adapters/*": [
        "./packages/matrx-agents/src/adapters/*"
      ]
    },
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowUnreachableCode": false,
    "noErrorTruncation": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "forceConsistentCasingInFileNames": false,
    "strictBindCallApply": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "tests/**/*",
    "scripts/**/*",
    "node_modules/flowbite-react/lib/esm/index.d.ts",
    "global.d.ts",
    "cartesia.d.ts",
    "components/**/*",
    "features/**/*",
    "app/**/*",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".next-agent-7a3b1d9209cb/types/**/*.ts",
    ".next-agent-7a3b1d9209cb/dev/types/**/*.ts",
    ".next-agent-0c602fac5c0e/types/**/*.ts",
    ".next-agent-0c602fac5c0e/dev/types/**/*.ts",
    ".next-agent-1ae521c7b5e0/types/**/*.ts",
    ".next-agent-1ae521c7b5e0/dev/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts"
  ],
  "exclude": [
    ".next*/**",
    ".next*",
    ".next",
    "node_modules",
    "_armani",
    "_dev",
    ".claude",
    "out",
    "utils/schema/schemaUtils.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ],
    "transpileOnly": true,
    "compilerOptions": {
      "ignoreDeprecations": "6.0",
      "rootDir": ".",
      "types": [
        "node"
      ],
      "lib": [
        "dom",
        "dom.iterable",
        "esnext"
      ],
      "module": "commonjs",
      "moduleResolution": "node",
      "baseUrl": ".",
      "paths": {
        "@/*": [
          "./*"
        ],
        "@components/ui/*": [
          "./components/ui/*"
        ],
        "@components/*": [
          "./components/*"
        ]
      }
    }
  }
}
