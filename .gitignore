# Cursor MCP config (contains access tokens)
.cursor/mcp.json

# Codex local config / environments (contains API keys — never commit)
.codex/

# TS strictness rollout — measurement artifacts (regenerated by `pnpm measure:strict`)
type-errors/
.tsconfig.measure.tmp.json

# Claude ephemeral agent worktrees (nested repos / copied trees — never commit)
.claude/worktrees/
.worktrees/

# dependencies
# SLASHLESS ON PURPOSE — do not "canonicalize" this to `node_modules/`. A trailing
# slash matches directories only; a SYMLINK named node_modules is not a directory,
# so `node_modules/` lets `git add -A` commit one. That happened three times
# (2026-08-11, 08-31, 09-11) and each broken link took every checkout's
# dependencies down with ELOOP on the next pull. This one line covers a directory
# OR a link at any depth. Guard: pnpm check:dependency-dirs-untracked.
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# workspace package build outputs
packages/*/dist/
packages/*/build/
packages/*/.turbo/
packages/*/tsconfig.tsbuildinfo

# testing
/coverage

# next.js — every distDir variant (.next, .next-preview, .next-agent-*, …)
# Both forms: bare + trailing-slash. Cursor's default ignore only covers `.next/`.
.next
.next*
.next*/
/out/

# Build-profile parks (private `_` folders at config load). Source of truth is
# always the live app/(admin) / app/(public) paths — never commit these.
app/_admin_build_excluded/
app/_public_build_excluded/
app/_core_build_excluded/
app/_transitional_build_excluded/
app/_popup_build_excluded/
app/_*_build_excluded.stale-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# IntelliJ IDEA
.idea/*
.idea*
# CMake
cmake-build-*/

# Exclude project-specific folders
_armani/
-armani/
_dev/
temp/
public/cache/


.env
.env.local
.env.development
.env.test
.env.production
.env*
!.env.example
!.dead
.env-backups/
 .history*
 .history/

enhanced-directory-structure.json
directory-structure.json
.history/

# Matrx Ship config (contains API key)
.matrx-ship.json

# Arman's secrets directory
.arman/secrets

# SMS documentation with sensitive Twilio IDs
features/sms/A2P_ISSUE.md
features/sms/API_FIXES.md

# pdfjs worker mirrored from node_modules by scripts/copy-pdfjs-worker.ts
# Regenerated on every install (postinstall) and on every build.
public/pdfjs/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Claude Code per-session agent dev servers (transient state)
.matrx/dev-sessions/

# Surface-check screenshots and other generated verification artifacts
.matrx/surface-check-artifacts/

# Local tool-trace output (transient diagnostics)
.matrx-debug/

# `pnpm db-types` staging file — generated types are written here and only renamed into place
# once complete, so a concurrent type-check never sees a half-written database.types.ts.
# A lingering staging file means a generation run failed; it must never be committable.
types/database.types.ts.staging
# Cross-repo parity tests create Python tempfile bridge modules in the repo root.
# They are transient inputs and must never be captured by a ship-mode release.
/tmp*.ts
.dev-login-nonce
.dev-login-nonce.*

# Generated by `pnpm build:kind-sandbox` (wired into `pnpm build`, same as
# public/blob-sw.js). The frame has `connect-src 'none', so a stale committed
# artifact would be a silently wrong renderer — always regenerate, never commit.
public/kind-sandbox.js
public/kind-sandbox.css

# S3 sandbox parity witness — regenerate with `pnpm witness:kind-sandbox-parity`
public/__kind-sandbox-*.html

# S5 rendering-parity sweep output (screenshots + report) — regenerate with
# `pnpm sweep:kind-sandbox-parity`.
.kind-sandbox-parity/

# Playwright run artifacts are reproducible local output.
/test-results/

# The mandate reference check (`check:mandate-references`) writes its module
# index cache here. It must never make the working tree dirty: a dirty tree is
# reported UNMEASURED with an `incomplete` verdict, which would mean the check
# spoiled its own report just by running.
.cache/

# PARKED CHECKOUTS — `.wt/` and `.coldwalk*/` hold other lanes' worktrees and
# symlinks (`.wt/aidream -> ../aidream`). Tailwind v4's automatic source
# detection honours this file: unignored, it followed that symlink into the
# sibling repo and Turbopack panicked on every route for every agent
# ("FileSystemPath("").join("../aidream") leaves the filesystem root",
# 2026-09-18). The census guards already skip these as parked checkouts.
.wt/
.coldwalk*/

# RELEASE — every run's log, every check's output, the fixer dispatcher's ledger
# (scripts/checks/FEATURE.md). tmp/ is not ignored as a whole on purpose.
tmp/release-logs/
tmp/checks/
tmp/fixer-logs/
.matrx/fixer-ledger.json
.matrx/fixer-dispatch.json
# Parked checkouts other sessions drop here (aidream clones, 2026-09-22); never committed by a sweep.
work/

# Agent scratch that a whole-tree commit (scripts/sync-main.py) must never pick up
/=
/tmp/
/measurements/
/scripts/.tmp-*
