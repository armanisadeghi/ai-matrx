-async def _follow_the_older_format(conn: Any, out: AttributeResult, fld: Any, doc: dict[str, Any], label: str) -> None:
-    """While the older table is the truth, a column's format on the copy is the older column's.
-
-    A person who changes a column's format on the older table (a plain column becomes an email, a
-    number becomes currency) after the first copy is changing the table that lives; the store's copy
-    wins every key on a rerun, so without this the copy kept the first format and the switch showed
-    it (CUTOVER-READINESS). Only where the column keeps its KIND (the store type): a format that
-    changes the kind would convert every cell, and is left for the readiness check to name. A
-    person's test edit of the column stays; the older format goes into the kept image.
-    """
-    planned_type = fld.data.get("type")
-    if planned_type != doc.get("type") or not await _older_is_truth(conn, fld.data.get("entity_definition_id")):
-        return
-    want_format = fld.data.get("format")
-    want_drawn = fld.data.get("display_format")
-    have_format = doc.get("format")
