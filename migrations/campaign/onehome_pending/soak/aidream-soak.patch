-def _older_style_in_the_stores_words(
-    style: dict[str, Any], ids: dict[Any, str], name: str, palette: set[str], out: AttributeResult
-) -> dict[str, Any]:
-    """The older table's colours as the store keys them — exactly what the older SCREEN painted.
-
-    The older grid kept colours keyed by column NAME (``colorBy``, ``columns.<name>``,
-    ``cells.<row>.<name>``, a rule's ``field``); the store keys them by Field ID and says so in its
-    refusal. Row ids need no translation: a moved row kept its id (CUT-4). ``version`` is the older
-    grid's bookkeeping. A colour the older screen never painted is NAMED here, never carried: the
-    older grid's ``isStyleColor`` drops every word outside the store's seven, so a stored "purple"
-    was invisible there, and writing a colour here would be the first time it ever showed.
-    """
-    from matrx_records.movers.typemap import slug
-
-    def field_id(col: Any) -> str | None:
-        return ids.get(col) or ids.get(slug(str(col or "")))
-
-    def unseen(where: str, color: Any) -> None:
-        if color in (None, "", _NO_COLOR):
-            return
-        out.refused.append(
-            f"table colors on {name}: {where} holds {color!r}, a colour the older screen never "
-            f"showed (it paints only {', '.join(sorted(palette))}); not carried, so the copy shows "
-            "that cell exactly as the older table did — with no colour"
-        )
-
-    wanted: dict[str, Any] = {}
-    for row_id, color in (style.get("rows") or {}).items():
-        if color in palette:
-            wanted.setdefault("rows", {})[row_id] = color
-        else:
-            unseen(f"row {str(row_id)[:8]}", color)
-    for col, color in (style.get("columns") or {}).items():
-        fid = field_id(col)
-        if not fid:
-            out.refused.append(f"table colors on {name}: column {col!r} is not a column of this table")
-        elif color in palette:
-            wanted.setdefault("columns", {})[fid] = color
-        else:
-            unseen(f"column {col}", color)
-    for row_id, by_col in (style.get("cells") or {}).items():
-        for col, color in (by_col or {}).items():
-            fid = field_id(col)
-            if not fid:
-                out.refused.append(f"table colors on {name}: cell column {col!r} is not a column of this table")
-            elif color in palette:
-                wanted.setdefault("cells", {}).setdefault(row_id, {})[fid] = color
-            else:
-                unseen(f"cell {str(row_id)[:8]}.{col}", color)
-    color_by = style.get("colorBy") or style.get("color_by")
-    if isinstance(color_by, dict) and field_id(color_by.get("field")):
-        wanted["color_by"] = {"field": field_id(color_by.get("field")), "target": color_by.get("target") or "row"}
-    rules = style.get("rules")
-    if isinstance(rules, list) and rules:
-        translated = []
-        for rule in rules:
-            if isinstance(rule, dict) and field_id(rule.get("field")):
-                translated.append({**rule, "field": field_id(rule.get("field"))})
-            else:
-                out.refused.append(
-                    f"table colors on {name}: a color rule reads "
-                    f"{rule.get('field') if isinstance(rule, dict) else rule!r}, not a column of this table"
-                )
-        if translated:
-            wanted["rules"] = translated
-    return wanted
