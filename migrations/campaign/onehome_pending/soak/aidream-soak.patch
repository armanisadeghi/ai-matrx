-THE DEFECT IT CLOSES (lane MOVER-CARRY-TAILS, 2026-09-26). The owner's "Copy again" button
-(aidream ``/cutover/.../copy-again``) held a durable claim per organization; a rerun an agent
-started from the terminal (``runner --move``) did not, so an agent's rerun and a person's press
-could copy the same organization at once. Both are idempotent copies, so the overlap cost time
-and a doubled report rather than data — but "who else is writing this organization's copies
-right now" is a question the MOVER must answer, not each host that calls it. So the claim lives
-here, inside :meth:`matrx_records.movers.move.TheMove.run`, and every writing run takes it: the
-button, the terminal, a test, a night job.
-
-WHY A ROW AND NOT AN ADVISORY LOCK. The server and most terminals reach Postgres through the
-transaction-mode pooler, where a session advisory lock dies with its own statement (measured
-2026-09-17, ``aidream/services/work_claims.py``). The claim is a row on ``platform._work_claim``
-(unique on ``(scope, claim_key)``), won by ``insert … on conflict do nothing`` — exactly one
-insert lands however many tasks try — carrying a LEASE so a holder that crashed cannot wedge the
-organization, and released by deleting only this hold's own row (``owner_task`` carries a
-per-hold token). Same table and same shape as the host's ``hold_work_claim``; restated in plain
-SQL because this package cannot import the server.
-
-A measuring run (``apply=False``) writes nothing and takes no claim.
-"""
-
-from __future__ import annotations
-
-import json
-import logging
-import os
-import socket
-import uuid
-from collections.abc import AsyncIterator
-from contextlib import asynccontextmanager
-from typing import Any
-
-logger = logging.getLogger(__name__)
-
-#: The claim's namespace on ``platform._work_claim``; the key is the organization id.
-CLAIM_SCOPE = "movers.organization"
-
-#: Longer than the largest organization's rerun can take — the crash bound, not a policy
-#: (reruns measure seconds per table; the largest organization holds ~120 tables).
-CLAIM_LEASE_SECONDS = 1800
-
-
-class MoverBusy(RuntimeError):
-    """Another writing run holds this organization. Nothing was started; the sentence says so."""
-
-    def __init__(self, organization_id: str, holder: dict[str, Any] | None, says: str) -> None:
-        super().__init__(says)
-        self.organization_id = organization_id
-        self.holder = holder or {}
-        self.says = says
-
-
-def _owner_token(entry: str) -> str:
-    return f"{entry}:{socket.gethostname()}:{os.getpid()}:{uuid.uuid4().hex[:12]}"[:200]
-
-
-def _busy_sentence(organization_name: str, holder: dict[str, Any] | None) -> str:
-    who = (holder or {}).get("entry") or "another copy"
-    since = (holder or {}).get("since")
-    name = organization_name or "This organization"
-    started = f", started {since}" if since else ""
-    return (
-        f"{name}'s tables are already being copied again ({who}{started}). Nothing new was "
-        "started; the switch updates when that copy finishes."
-    )
-
-
-@asynccontextmanager
-async def organization_claim(
-    conn: Any,
-    organization_id: str,
-    *,
-    entry: str,
-    organization_name: str = "",
-    lease_seconds: int = CLAIM_LEASE_SECONDS,
-    detail: dict[str, Any] | None = None,
-) -> AsyncIterator[str]:
-    """Hold the organization's mover claim for the body, or raise :class:`MoverBusy` at once.
-
-    ``entry`` names who is copying (``copy again button``, ``terminal``, a test's name) — it is
-    what a refused second caller is told.
-    """
-    owner = _owner_token(entry)
-    body = json.dumps({**(detail or {}), "entry": entry})
-    landed = await conn.fetchval(
-        "insert into platform._work_claim (scope, claim_key, state, owner_task, detail, expires_at) "
-        "values ($1, $2, 'running', $3, $4::jsonb, clock_timestamp() + make_interval(secs => $5)) "
-        "on conflict (scope, claim_key) do nothing returning id::text",
-        CLAIM_SCOPE, organization_id, owner, body, float(lease_seconds),
-    )
-    if landed is None:
-        # A holder that died leaves a row past its lease: take it over, atomically, so a live
-        # holder is untouched and two takers cannot both win.
-        landed = await conn.fetchval(
-            "update platform._work_claim c set state = 'running', owner_task = $3, detail = $4::jsonb, "
-            "  updated_at = clock_timestamp(), expires_at = clock_timestamp() + make_interval(secs => $5) "
-            "where c.id = (select id from platform._work_claim where scope = $1 and claim_key = $2 "
-            "  and state <> 'done' and expires_at <= clock_timestamp() for update skip locked) "
-            "returning c.id::text",
-            CLAIM_SCOPE, organization_id, owner, body, float(lease_seconds),
-        )
-        if landed is not None:
-            logger.warning(
-                "[move] the claim on organization %s was past its lease and was taken over; "
-                "its previous holder finished nothing after that", organization_id,
-            )
-    if landed is None:
-        row = await conn.fetchrow(
-            "select detail, created_at from platform._work_claim where scope = $1 and claim_key = $2",
-            CLAIM_SCOPE, organization_id,
-        )
-        holder: dict[str, Any] = {}
-        if row is not None:
-            raw = row["detail"]
-            holder = (json.loads(raw) if isinstance(raw, str) else dict(raw or {}))
-            holder["since"] = row["created_at"].strftime("%H:%M UTC") if row["created_at"] else None
-        if not organization_name:
-            organization_name = await conn.fetchval(
-                "select name from iam.organizations where id = $1::uuid", organization_id
-            ) or ""
-        raise MoverBusy(organization_id, holder, _busy_sentence(organization_name, holder))
-    try:
-        yield landed
-    finally:
-        try:
-            released = await conn.fetchval(
-                "delete from platform._work_claim where scope = $1 and claim_key = $2 and owner_task = $3 "
-                "returning id::text",
-                CLAIM_SCOPE, organization_id, owner,
-            )
-            if released is None:
-                logger.warning(
-                    "[move] the claim on organization %s was no longer this run's at release "
-                    "(a later run took it over past its lease)", organization_id,
-                )
-        except Exception:  # noqa: BLE001 — never turn finished work into a failure
-            logger.warning(
-                "[move] could not release the claim on organization %s; its lease frees it within %ss",
-                organization_id, lease_seconds, exc_info=True,
-            )
-
-
-__all__ = ["CLAIM_LEASE_SECONDS", "CLAIM_SCOPE", "MoverBusy", "organization_claim"]
