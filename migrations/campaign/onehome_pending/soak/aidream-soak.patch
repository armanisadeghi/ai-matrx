-            bucket, f"{name} ({'.'.join(p[:8] for p in path)})",
-            "select custom.table_decorate($1::uuid, $2::uuid, $3::text[], $4::jsonb)",
-            table.organization_id, table.id, list(path), json.dumps(value),
