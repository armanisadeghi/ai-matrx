-def _carried_as_how_it_is_drawn(document: dict, declared: str) -> bool:
-    """The format arrived as ``display_format`` — ONLY in the two cases the move rules allow.
-
-    1. The store insists on a rule for this format (``custom._field_type_parity_guard``) and the
-       person never wrote one: the document carries no rule of that kind.
-    2. The column moved as TEXT (some cells hold words its old type cannot), drawn as before.
-
-    Any other ``display_format``-only arrival is a dropped format and fails the gate.
-    """
-    drawn = document.get("display_format")
-    if not isinstance(drawn, dict) or drawn.get("id") != declared or document.get("format"):
-        return False
-    if document.get("type") == "text" and declared not in typemap.RULES_THE_STORE_INSISTS_ON:
-        return True
-    insists = typemap.RULES_THE_STORE_INSISTS_ON.get(declared)
-    if not insists:
-        return document.get("type") == "text"
-    kinds = {str(r.get("kind")) for r in document.get("rules") or []}
-    return not (kinds & {r["kind"] for r in insists})
