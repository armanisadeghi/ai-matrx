-def _leaves(decorations: dict[str, Any]) -> dict[tuple[str, ...], Any]:
-    """Every colour a decorations document paints, one path per colour (rules and color_by whole)."""
-    got: dict[tuple[str, ...], Any] = {}
-    for row_id, color in (decorations.get("rows") or {}).items():
-        got[("rows", row_id)] = color
-    for fid, color in (decorations.get("columns") or {}).items():
-        got[("columns", fid)] = color
-    for row_id, by_field in (decorations.get("cells") or {}).items():
-        for fid, color in (by_field or {}).items():
-            got[("cells", row_id, fid)] = color
-    if not _blank(decorations.get("color_by")):
-        got[("color_by",)] = decorations["color_by"]
-    if not _blank(decorations.get("rules")):
-        got[("rules",)] = decorations["rules"]
-    return got
