-    if not decorate_door:
-        out.refused.append(
-            f"table colors on {name}: door absent — custom.table_decorate is not on this "
-            "database yet (GRID-PRIMITIVES); a rerun after it lands carries them"
-        )
-        return
-    ids = {f.data.get("key"): f.id for f in plan.fields if f.data.get("entity_definition_id") == table.id}
-    palette = set(await conn.fetchval("select custom.decoration_colors()") or [])
-    wanted = _leaves(_older_style_in_the_stores_words(style, ids, name, palette, out))
-
-    if not older_is_truth:
-        for path, value in wanted.items():
-            if not _blank(_leaves(present).get(path)):
-                out.bump(out.already, "table colors")
-                continue
-            await attempt(
-                "table colors", f"{name} ({'.'.join(p[:8] for p in path)})",
-                "select custom.table_decorate($1::uuid, $2::uuid, $3::text[], $4::jsonb)",
-                table.organization_id, table.id, list(path), json.dumps(value),
-            )
-        return
-
-    # A person's open test note on the Table record: the kept image is what the switch puts back.
-    tested = False
-    if await conn.fetchval("select to_regclass('platform.cutover_evaluation_write') is not null"):
-        kept = await conn.fetchval(
-            "select e.pre_image -> 'data' -> 'decorations' from platform.cutover_evaluation_write e "
-            "where e.organization_id = $1::uuid and e.record_id = $2::uuid and e.replaced_at is null and not e.created",
-            table.organization_id, table.id,
-        )
-        if kept is not None or await conn.fetchval(
-            "select exists (select 1 from platform.cutover_evaluation_write e where e.organization_id = $1::uuid "
-            "and e.record_id = $2::uuid and e.replaced_at is null and not e.created)",
-            table.organization_id, table.id,
-        ):
-            tested = True
-            kept = json.loads(kept) if isinstance(kept, str) else kept
-            present = kept if isinstance(kept, dict) else {}
-
-    held = _leaves(present)
-    changes: list[tuple[tuple[str, ...], Any, str]] = []
-    for path, value in wanted.items():
-        if held.get(path) == value:
-            out.bump(out.already, "table colors")
-        else:
-            changes.append((path, value, "table colors" if path not in held else "table colors changed on the older table"))
-    for path in held:
-        if path not in wanted:
-            changes.append((path, None, "table colors removed on the older table"))
-    if not changes:
-        return
-    if tested:
-        image = present
-        for path, value, _ in changes:
-            image = _with_leaf(image, path, value)
-        await attempt(
-            "table colors (into the copy's kept image)", name,
-            "select platform.cutover_evaluation_carry($1::uuid, $2::uuid, jsonb_build_object('decorations', $3::jsonb))",
-            table.organization_id, table.id, json.dumps(image),
-        )
-        return
-    for path, value, bucket in changes:
