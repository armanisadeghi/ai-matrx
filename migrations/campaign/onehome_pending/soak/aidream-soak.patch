-#: The ONE database (aidream CLAUDE.md), by the config name every aidream module uses.
-DATABASE = "supabase_automation_matrix"
-
-#: How long the press may run inside the database. It measures every organization twice and
-#: re-syncs every copy; the clone rehearsal (every organization of production's data) measured
-#: the whole press — see common-docs PROGRESS-FINAL-SWITCH.md.
-PRESS_STATEMENT_TIMEOUT_MS = 600_000
-#: How long every read of ``platform.final_switch_readiness()`` may run: the page's read, the press's
-#: opening and closing read, Step 1's reads, and run.sh. It is a per-organization census (4 to 10 s on
-#: a quiet database, 39 s under load), so it gets its own bounded clock, never the role's 30 s.
-READINESS_STATEMENT_TIMEOUT_MS = 180_000
-#: A row lock held by somebody else longer than this ends the press, rolled back whole and
-#: recorded, instead of freezing a live user behind it.
-PRESS_LOCK_TIMEOUT_MS = 30_000
-
-
-@dataclass
-class FinalSwitchRun:
-    """What one press (or undo) through the server did, step by step, with timings."""
-
-    direction: str
-    readiness_before: dict[str, Any] | None = None
