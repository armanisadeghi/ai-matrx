-    async def fetch(self, sql: str, *args: Any) -> list[dict[str, Any]]:
-        return []  # no older shares, no older saved views
-
-    async def execute(self, sql: str, *args: Any) -> str:
-        if "update platform.saved_view set is_default = true" in sql:
-            view_id, table_id = args
-            others = [v for v in self.views if v["subject_id"] == table_id and v["is_default"] and v["id"] != view_id]
-            if not others:
