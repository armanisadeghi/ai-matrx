-    "column": "columns removed on the older table",
-    "choice": "choices removed on the older list",
-    "table": "tables archived on the older side",
-    "list": "lists archived on the older side",
-    "share": "shares taken away on the older table",
-    # LIST-COPY-PERMISSIVE: a choice an earlier copy invented from an off-list value, archived;
-    # the cells keep the words as other values.
-    "invented_choice": "choices the copy had invented, taken off (the values stay as other values)",
