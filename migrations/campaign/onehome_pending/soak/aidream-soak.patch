-def _with_leaf(decorations: dict[str, Any], path: tuple[str, ...], value: Any) -> dict[str, Any]:
-    """``decorations`` with one leaf set (or removed, for None), empty parents pruned."""
-    doc = json.loads(json.dumps(decorations or {}))
-    node = doc
-    for part in path[:-1]:
-        if not isinstance(node.get(part), dict):
-            node[part] = {}
-        node = node[part]
-    if value is None:
-        node.pop(path[-1], None)
-        for depth in range(len(path) - 1, 0, -1):
-            parent = doc
-            for part in path[: depth - 1]:
-                parent = parent.get(part, {})
-            if parent.get(path[depth - 1]) == {}:
-                parent.pop(path[depth - 1], None)
-    else:
-        node[path[-1]] = value
-    doc["version"] = 1
-    return doc
