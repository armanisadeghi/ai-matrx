-async def _carry_decorations(
-    conn: Any, out: AttributeResult, table: Any, name: str, doc: dict[str, Any],
-    plan: MovePlan, decorate_door: bool, attempt: Any,
-) -> None:
-    """The older table's colours on the copy — and, while the older table is the truth, KEPT EQUAL.
-
-    WHILE THE ORGANIZATION'S DATA TABLES SWITCH IS OFF the older table is where the table lives:
-    people and agents change its colours there, and the copy is what the switch will show. So a
-    rerun makes the copy paint exactly what the older screen paints — a colour changed on the
-    older table is changed on the copy, one removed there is removed here (CUTOVER-READINESS,
-    2026-09-25: the attribute pass was additive-only, so a cell recoloured or cleared after the
-    first copy kept its first colour on the copy forever, and the switch showed it). A person's
-    test edit of the copy's colours (lane COPY-WRITABLE) is left on screen: the older table's
-    colours go into the kept image the switch puts back.
-
-    AFTER THE SWITCH the copy is the truth and the pass is additive only, as it always was: a
-    colour is written only where the store's copy holds none, never over a person's own.
-    """
-    style = table.carry.get("decorations")
-    style = style if isinstance(style, dict) else {}
-    older_is_truth = bool(
-        await conn.fetchval(
-            "select to_regprocedure('platform.table_lives_in(uuid)') is not null "
-            "and exists (select 1 from workbench.udt_datasets d where d.id = $1::uuid and d.deleted_at is null) "
-            "and platform.table_lives_in($1::uuid) = 'older'",
-            table.id,
-        )
-    ) if table.origin.table == "workbench.udt_datasets" else False
-    present = doc.get("decorations") if isinstance(doc.get("decorations"), dict) else {}
-    if not style and not (older_is_truth and _leaves(present)):
