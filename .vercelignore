# Webpack cache pack files (exceed Vercel's 1.5GB limit)
.next/cache/webpack/**/*.pack

# Large cache files
.next/cache/**/*.log
node_modules/.cache

# Turbo cache (if using turbo)
.turbo

# Source maps (generated during build)
**/*.map

# Test coverage — MUST stay root-anchored: a bare "coverage" matches every
# directory named coverage at ANY depth, which silently stripped the
# app/.../sites/[siteId]/coverage route from prod uploads (prod-only 404).
/coverage

# Development files
.vscode
.idea
*.sw

# p  # REMOVED: This was blocking app/(public)/p/ from deploying
.DS_Store

# Temporary files
*.tmp
*.temp

