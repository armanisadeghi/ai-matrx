/**
 * Where a pick inside the phone "Chat options" sheet sends the person.
 *
 * Attach is a picker the person returns from: choosing a note / file / context
 * value goes back to the tab list so they can keep setting up the chat (PB-08,
 * 2026-10-01: attaching a note closed the whole sheet with no way back). Every
 * other tab's `onClose` means "I'm leaving" (e.g. Connections navigates away),
 * so it closes the sheet.
 */

import type { RunControlsTab } from "./RunControlsTabPanel";

export type SheetPickTarget = "index" | "close";

export function sheetPickTarget(tab: RunControlsTab): SheetPickTarget {
  return tab === "attach" ? "index" : "close";
}
