/**
 * The ONE place a `<decision>` body becomes options. Used by the splitter
 * (content-splitter-core), the stream accumulator, and parseDecisionXml — the
 * server twin is aidream matrx_ai/processing/blocks/parsers/decision_parser.py
 * and MUST stay in lockstep with this file.
 *
 * Tolerant of real model output (captured 2026-10-04): extra attributes on
 * <option> (`id` before/after `label`), single or double quotes, indentation
 * and blank lines, and self-describing options with no `label` attribute
 * (`<option id="x">Label text</option>` — the text names the choice).
 * Only options whose closing tag has arrived count.
 */

export interface ParsedDecisionOption {
    label: string;
    text: string;
}

const OPTION_RE = /<option\s+label="([^"]*)">([\s\S]*?)<\/option>/g;
const ATTR_RE = /([\w-]+)\s*=\s*(?:"([^"]*)"|'([^']*)')/g;

export function parseOptionAttributes(attrString: string): Record<string, string> {
    const attrs: Record<string, string> = {};
    ATTR_RE.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = ATTR_RE.exec(attrString)) !== null) {
        attrs[m[1]] = m[2] ?? m[3] ?? '';
    }
    return attrs;
}

export function parseDecisionOptionsFromBody(body: string): ParsedDecisionOption[] {
    const options: ParsedDecisionOption[] = [];
    const re = new RegExp(OPTION_RE.source, OPTION_RE.flags);
    let m: RegExpExecArray | null;
    while ((m = re.exec(body)) !== null) {
        const attrs = parseOptionAttributes(m[1]);
        const text = m[2].trim();
        const label = (attrs.label ?? attrs.title ?? attrs.name ?? '').trim() || text.split('\n')[0].trim();
        if (label === '') continue;
        options.push({ label, text });
    }
    return options;
}
