{
  "//": "Declarations for the published package (P26). Emits dist/**/*.d.ts beside tsup's dist/**/*.js. Type ERRORS here are the app's type-check's to report; this config only emits.",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "incremental": false,
    "allowJs": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "plugins": [],
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../global.d.ts"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/__mocks__/**",
    "src/**/__fixtures__/**",
    "src/**/fixtures/**",
    "src/**/test-utils/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*"
  ]
}
