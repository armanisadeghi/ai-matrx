{
  "name": "@ai-matrx/chat",
  "version": "0.0.0",
  "private": true,
  "description": "AI Matrx chat: running agents, chat, tool calls, streaming, context management (moved from matrx-frontend, R1/R2).",
  "//": "exports = the public surface over SOURCE (this workspace). The published map over dist/ is generated by scripts/finish-build.mjs from scripts/public-surface.mjs; check:package proves the two agree.",
  "exports": {
    "./host": "./src/host/index.ts",
    "./host/react": "./src/host/react.tsx",
    "./action-requests/*": "./src/action-requests/*",
    "./agent-copy/*": "./src/agent-copy/*",
    "./agents/*": "./src/agents/*",
    "./canvas/*": "./src/canvas/*",
    "./compute/*": "./src/compute/*",
    "./context/*": "./src/context/*",
    "./context-menu/*": "./src/context-menu/*",
    "./conversation/*": "./src/conversation/*",
    "./cx-chat/*": "./src/cx-chat/*",
    "./cx-conversation/*": "./src/cx-conversation/*",
    "./host/*": "./src/host/*",
    "./mandates/*": "./src/mandates/*",
    "./next/*": "./src/next/*",
    "./public-chat/*": "./src/public-chat/*",
    "./quick-actions/*": "./src/quick-actions/*",
    "./store/*": "./src/store/*",
    "./surfaces/*": "./src/surfaces/*",
    "./tool-call-visualization/*": "./src/tool-call-visualization/*",
    "./ui/*": "./src/ui/*",
    "./utils/*": "./src/utils/*",
    "./voice-agent/*": "./src/voice-agent/*",
    "./window-panels/*": "./src/window-panels/*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && cd ../.. && pnpm -s tsc -p packages/chat/tsconfig.build.json; cd packages/chat && node scripts/finish-build.mjs",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "check:package": "pnpm build && publint ./dist && node scripts/verify-tarball.mjs"
  },
  "devDependencies": {
    "publint": "^0.3.25",
    "tsup": "^8.5.1"
  }
}
