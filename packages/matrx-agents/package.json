{
  "name": "@matrx/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Redux state + thunks + selectors for the AI Matrx agent system. Framework-agnostic; consumers plug in their own Supabase client, fetch impl, and callback manager via configure().",
  "exports": {
    "./config": "./src/config/registry.ts",
    "./build-reducer-map": "./src/build-reducer-map.ts",
    "./redux/slices": "./src/redux/slices.ts",
    "./redux/thunks": "./src/redux/thunks.ts",
    "./redux/selectors": "./src/redux/selectors.ts",
    "./redux/hooks": "./src/redux/hooks.ts",
    "./stream/ndjson": "./src/stream/ndjson.ts",
    "./presentation/result": "./src/presentation/result.ts",
    "./adapters/auth": "./src/adapters/auth.ts",
    "./adapters/callback-manager": "./src/adapters/callback-manager.ts",
    "./adapters/fetch": "./src/adapters/fetch.ts",
    "./adapters/logger": "./src/adapters/logger.ts",
    "./adapters/supabase": "./src/adapters/supabase.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:stream": "tsc --noEmit --strict --target ES2022 --lib DOM,ES2022 --module ESNext --moduleResolution Bundler src/stream/ndjson.ts"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "react-redux": "^9.0.0",
    "reselect": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "sideEffects": false
}
