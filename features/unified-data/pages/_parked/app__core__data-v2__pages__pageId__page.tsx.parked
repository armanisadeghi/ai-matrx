"use client";

// app/(core)/data-v2/pages/[pageId]/page.tsx — THE MOUNT, AND NOTHING MORE. One page built from
// tables (v6 lane 11, wave D); `new?table=<id>` makes one. The screen is `PageRoute`.
import { use } from "react";

import { PageRoute } from "@/features/unified-data/pages/PageRoute";

export default function DataPageRoute({ params }: { params: Promise<{ pageId: string }> }) {
  const { pageId } = use(params);
  return <PageRoute pageId={pageId} />;
}
