exports[`the generic kind-value layout lays out seo_package from its schema 1`] = `"<section class="matrx-pl"><div class="matrx-pl-eyebrow">SEO Package</div><h2 class="matrx-pl-title">Dental Implant Financing: What It Costs Per Month</h2><dl class="matrx-pl-kv"><dt>Slug</dt><dd>dental-implant-financing-monthly-cost</dd><dt>Primary keyword</dt><dd>dental implant financing</dd><dt>Meta description</dt><dd>The three ways to finance dental implants, compared with real monthly numbers — and exactly what to bring to your first consultation.</dd></dl><h3>FAQ</h3><table><thead><tr><th>Question</th><th>Answer</th></tr></thead><tbody><tr><td>Can I finance dental implants with bad credit?</td><td>Yes. In-house payment plans and third-party medical lenders both approve applicants outside prime credit, usually at a higher APR and with a larger deposit.</td></tr><tr><td>Does dental insurance cover any of the implant cost?</td><td>Most plans cover the crown but not the titanium post, which is why two quotes for the same procedure can differ by thousands.</td></tr></tbody></table><h3>Keywords</h3><ul><li>dental implant financing</li><li>dental implant cost per month</li><li>implant payment plans</li><li>financing dental implants with bad credit</li></ul><h3>Open graph</h3><dl class="matrx-pl-kv"><dt>Og:type</dt><dd>article</dd><dt>Og:title</dt><dd>Dental Implant Financing: What It Costs Per Month</dd><dt>Og:description</dt><dd>The three ways to finance dental implants, compared with real monthly numbers.</dd></dl><h3>Schema org</h3><dl class="matrx-pl-kv"><dt>@type</dt><dd>FAQPage</dd><dt>@context</dt><dd><a href="https://schema.org">https://schema.org</a></dd></dl><h4>Main entity</h4><div class="matrx-pl-card"><h5>1. Can I finance dental implants with bad credit?</h5><dl class="matrx-pl-kv"><dt>@type</dt><dd>Question</dd></dl><h5>Accepted answer</h5><dl class="matrx-pl-kv"><dt>Text</dt><dd>Yes. In-house payment plans and third-party medical lenders both approve applicants outside prime credit, usually at a higher APR and with a larger deposit.</dd><dt>@type</dt><dd>Answer</dd></dl></div></section>"`;

exports[`the generic kind-value layout lays out study_notes from its schema 1`] = `"<section class="matrx-pl"><div class="matrx-pl-eyebrow">Study Notes</div><h2 class="matrx-pl-title">Plate Tectonics: Earth&#39;s Moving Crust</h2><h3>Sections</h3><table><thead><tr><th>Heading</th><th>Summary</th><th>Examples</th><th>Key points</th></tr></thead><tbody><tr><td>What plate tectonics says</td><td>The lithosphere is not one shell but a set of rigid plates resting on the softer asthenosphere. They move slowly enough to be invisible in a lifetime and fast enough to rebuild the map over millions of years.</td><td><ul class="matrx-pl-cell-list"><li>Cracked eggshell floating on the thick white beneath it.</li></ul></td><td><ul class="matrx-pl-cell-list"><li>The lithosphere is Earth&#39;s rigid outer shell, divided into tectonic plates.</li><li>Plates rest on the asthenosphere, a softer, partly molten layer of the mantle.</li><li>Plates move a few centimetres a year — about the rate fingernails grow.</li></ul></td></tr><tr><td>The three boundaries</td><td>Almost everything the theory explains happens where two plates meet, and which of the three meetings it is decides what gets built.</td><td><ul class="matrx-pl-cell-list"><li>Mid-Atlantic Ridge — divergent, and still widening.</li><li>The Andes — oceanic crust diving under a continent.</li><li>The San Andreas Fault — transform, and defined by its earthquakes.</li></ul></td><td><ul class="matrx-pl-cell-list"><li>Divergent: plates move apart and new crust forms — constructive.</li><li>Convergent: plates collide; denser oceanic crust subducts — destructive.</li><li>Transform: plates slide past one another; no crust made or destroyed.</li></ul></td></tr></tbody></table><h3>Glossary</h3><table><thead><tr><th>Term</th><th>Definition</th></tr></thead><tbody><tr><td>Lithosphere</td><td>Earth&#39;s rigid outer shell — the crust plus the uppermost mantle — broken into the tectonic plates.</td></tr><tr><td>Subduction</td><td>The sinking of denser oceanic crust beneath another plate at a convergent boundary, back into the mantle.</td></tr><tr><td>Slab pull</td><td>The pull of a cold, dense subducting plate as it sinks, now thought to be the strongest force moving the plates.</td></tr></tbody></table><h3>Overview</h3><p>Earth&#39;s rigid outer shell is broken into large plates that drift a few centimetres a year over the softer layer beneath. Where they meet, they pull apart, collide, or slide past one another — and each kind of meeting builds a different feature, from mid-ocean ridges to the Himalayas to the earthquakes of California.</p></section>"`;

exports[`the generic kind-value layout lays out study_plan from its schema 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Study Plan</h2><h3>Days</h3><div class="matrx-pl-card"><h5>Item 1</h5><dl class="matrx-pl-kv"><dt>Day date</dt><dd>2026-08-26</dd><dt>Is rest day</dt><dd>No</dd><dt>Rationale</dt><dd>Front-load the weakest topic immediately.</dd></dl><h5>Blocks</h5><table><thead><tr><th>Label</th><th>Topic</th><th>Estimated minutes</th><th>Target kind</th><th>Method</th><th>Rationale</th><th>Estimated items</th></tr></thead><tbody><tr><td>Flashcard Review</td><td>Cellular Energetics</td><td>15</td><td>review</td><td>Spaced repetition</td><td>Clear out due items to build a solid foundation.</td><td>15</td></tr><tr><td>Deep Dive: C4/CAM Pathways</td><td>C4/CAM pathways</td><td>30</td><td>weak_area</td><td>Diagramming and comparison tables</td><td>Tackle your weakest area first while you are fresh.</td><td></td></tr></tbody></table></div><div class="matrx-pl-card"><h5>Item 2</h5><dl class="matrx-pl-kv"><dt>Day date</dt><dd>2026-08-30</dd><dt>Is rest day</dt><dd>Yes</dd><dt>Rationale</dt><dd>Mandatory rest day to recover.</dd></dl><h5>Blocks</h5><table><thead><tr><th>Label</th><th>Estimated minutes</th><th>Target kind</th><th>Rationale</th></tr></thead><tbody><tr><td>Rest Day</td><td>0</td><td>rest</td><td>Enjoy a well-deserved break to prevent burnout.</td></tr></tbody></table></div><div class="matrx-pl-card"><h5>Item 3</h5><dl class="matrx-pl-kv"><dt>Day date</dt><dd>2026-09-05</dd><dt>Is rest day</dt><dd>No</dd><dt>Rationale</dt><dd>Full practice run before the final stretch.</dd></dl><h5>Blocks</h5><table><thead><tr><th>Label</th><th>Topic</th><th>Estimated minutes</th><th>Target kind</th><th>Method</th><th>Rationale</th><th>Estimated items</th></tr></thead><tbody><tr><td>Practice Test</td><td>Cellular Energetics</td><td>45</td><td>practice_test</td><td>Simulated exam conditions</td><td>Build stamina and test readiness under pressure.</td><td>20</td></tr></tbody></table></div><h3>Overall rationale</h3><p>This plan prioritizes your weakest areas (C4/CAM and Calvin cycle) in the first week to arrest the downward trend in accuracy, fitting within the 45-minute daily budget, honoring Sunday rest days, and tapering into confidence-building before the September 9th exam.</p></section>"`;
