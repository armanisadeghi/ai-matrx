exports[`structured type layouts over real stored rows troubleshooting (object) b4e6888b-fd5b-48c1-b6bb-6809faed418f prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Docker Build Fails</h2><h3>1. docker build exits with &quot;no space left on device&quot;</h3><h5>Likely causes</h5><ul><li>Dangling images and build cache filling the disk</li><li>Docker&#39;s data root on a small volume</li></ul><div class="matrx-pl-card matrx-pl-long"><h5>Solution 1: Reclaim Docker disk space</h5><p>Prune unused layers and caches</p><ol><li><strong>Prune the system</strong> <span class="matrx-pl-muted matrx-pl-small">(2 min)</span><div>Remove stopped containers, unused images, and cache</div><pre>docker system prune -a --volumes</pre></li><li><strong>Check remaining space</strong> <span class="matrx-pl-muted matrx-pl-small">(1 min)</span><div>Confirm the disk recovered</div><pre>df -h /var/lib/docker</pre></li></ol></div><p class="matrx-pl-small matrx-pl-muted">Related: Slow image builds, Out-of-memory during build</p></section>"`;

exports[`the generic kind-value layout lays out cms_page_build from its schema 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Built Page</h2><dl class="matrx-pl-kv"><dt>Route</dt><dd>/services/runners-knee</dd><dt>Css</dt><dd>.page{max-width:68ch;margin:0 auto;line-height:1.6}.lede{font-size:1.125rem}.cta{font-weight:600}</dd><dt>Page ID</dt><dd>7f3c1e88-5a2b-4c19-9d64-2b8e0a1f4c37</dd><dt>Meta title</dt><dd>Physical Therapy for Runner&#39;s Knee | Northside Physio</dd><dt>Write target</dt><dd>live</dd><dt>Meta description</dt><dd>Runner&#39;s knee is a loading problem, not joint wear. See how our assessment finds the cause at the hip and foot, and what a six-to-ten week program looks like.</dd></dl><h3>HTML</h3><pre>&lt;article class=&quot;page&quot;&gt;&lt;h1&gt;Physical Therapy for Runner&#39;s Knee&lt;/h1&gt;&lt;p class=&quot;lede&quot;&gt;Runner&#39;s knee rarely comes from the knee itself. Most cases trace back to how the hip and foot are loading.&lt;/p&gt;&lt;section&gt;&lt;h2&gt;What runner&#39;s knee actually is&lt;/h2&gt;&lt;p&gt;Patellofemoral pain syndrome is pain around or behind the kneecap, usually worse on stairs, hills, and after sitting a long while.&lt;/p&gt;&lt;/section&gt;&lt;section&gt;&lt;h2&gt;How we assess it&lt;/h2&gt;&lt;p&gt;The first visit looks above and below the knee before it looks at the knee.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Hip strength and control, single-leg&lt;/li&gt;&lt;li&gt;Ankle mobility and foot loading&lt;/li&gt;&lt;/ul&gt;&lt;/section&gt;&lt;p class=&quot;cta&quot;&gt;Book an assessment and bring the shoes you run in most often.&lt;/p&gt;&lt;/article&gt;</pre></section>"`;

