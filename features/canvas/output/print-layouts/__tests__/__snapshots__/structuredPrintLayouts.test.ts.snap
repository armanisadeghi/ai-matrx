exports[`structured type layouts over real stored rows transcript (md) 7c811f22-8edc-43c8-a417-40736779d132 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Transcript</h2><table><thead><tr><th>Time</th><th>Speaker</th><th>Text</th></tr></thead><tbody><tr><td><span class="matrx-pl-muted matrx-pl-small">0:04</span></td><td><strong>Host</strong></td><td>Welcome back to &quot;Burn Notice,&quot; the spicy science podcast.</td></tr><tr><td><span class="matrx-pl-muted matrx-pl-small">0:09</span></td><td><strong>Dr. Reyes</strong></td><td>Happy to be here — and yes, I brought a reaper.</td></tr><tr><td><span class="matrx-pl-muted matrx-pl-small">0:18</span></td><td><strong>Host</strong></td><td>Brave. So why DO we enjoy something that literally signals pain?</td></tr><tr><td><span class="matrx-pl-muted matrx-pl-small">0:26</span></td><td><strong>Dr. Reyes</strong></td><td>It&#39;s the endorphin response. Your brain treats the burn as a threat and floods you with feel-good chemicals.</td></tr><tr><td><span class="matrx-pl-muted matrx-pl-small">0:41</span></td><td></td><td>[Sound of bottle opening]</td></tr><tr><td><span class="matrx-pl-muted matrx-pl-small">0:45</span></td><td><strong>Host</strong></td><td>...okay, I&#39;m tasting it. Oh. Oh no.</td></tr><tr><td><span class="matrx-pl-muted matrx-pl-small">0:52</span></td><td><strong>Dr. Reyes</strong></td><td>Dairy&#39;s on your left.</td></tr></tbody></table></section>"`;

