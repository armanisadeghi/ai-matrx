exports[`structured type layouts over real stored rows comparison (object) 73aa749a-b7fe-4af3-826b-98ce02057e21 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Apollo 11 vs. Apollo 17</h2><div class="matrx-pl-sub"><p>The first and last crewed Moon landings, three and a half years apart.</p></div><table><thead><tr><th>Criterion</th><th>Apollo 11</th><th>Apollo 17</th></tr></thead><tbody><tr><td><strong>Launch Date</strong></td><td>July 16, 1969</td><td>December 7, 1972</td></tr><tr><td><strong>Landing Site</strong></td><td>Sea of Tranquility</td><td>Taurus-Littrow Valley</td></tr><tr><td><strong>Commander</strong></td><td>Neil Armstrong</td><td>Eugene Cernan</td></tr><tr><td><strong>Crew with Scientific Background</strong></td><td>&#10007; No</td><td>&#10003; Yes</td></tr><tr><td><strong>Surface Mobility</strong></td><td>On foot only</td><td>Lunar Roving Vehicle</td></tr><tr><td><strong>Time on Lunar Surface (EVA hours)</strong></td><td>&#9733;&#9733;&#9734;&#9734;&#9734; <span class="matrx-pl-muted">2/5</span></td><td>&#9733;&#9733;&#9733;&#9733;&#9733; <span class="matrx-pl-muted">5/5</span></td></tr><tr><td><strong>Total Time on Moon (days)</strong></td><td>~1 day</td><td>~3 days</td></tr><tr><td><strong>Lunar Samples Returned</strong></td><td>~22 kg</td><td>~111 kg</td></tr><tr><td><strong>Primary Mission Goal</strong></td><td>Prove a landing was possible</td><td>Maximize scientific return</td></tr><tr><td><strong>Historic Significance</strong></td><td>&#9733;&#9733;&#9733;&#9733;&#9733; <span class="matrx-pl-muted">5/5</span></td><td>&#9733;&#9733;&#9733;&#9733;&#9734; <span class="matrx-pl-muted">4/5</span></td></tr></tbody></table></section>"`;

exports[`structured type layouts over real stored rows comparison (object) e22840c4-14b8-4d0a-b855-f3f6f2f44f9c prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Apollo 11 vs. Apollo 17</h2><div class="matrx-pl-sub"><p>The first Moon landing compared with the last — how far the program advanced in three and a half years.</p></div><table><thead><tr><th>Criterion</th><th>Apollo 11 (1969)</th><th>Apollo 17 (1972)</th></tr></thead><tbody><tr><td><strong>Launch Date</strong></td><td>July 16, 1969</td><td>December 7, 1972</td></tr><tr><td><strong>Landing Site</strong></td><td>Sea of Tranquility (flat mare plain)</td><td>Taurus-Littrow (mountains and valley)</td></tr><tr><td><strong>Moonwalkers</strong></td><td>Neil Armstrong, Buzz Aldrin</td><td>Eugene Cernan, Harrison Schmitt</td></tr><tr><td><strong>Trained Geologist on Crew</strong></td><td>&#10007; No</td><td>&#10003; Yes</td></tr><tr><td><strong>Lunar Roving Vehicle</strong></td><td>&#10007; No</td><td>&#10003; Yes</td></tr><tr><td><strong>Total Surface Stay</strong></td><td>~21.5 hours</td><td>~75 hours (3 days)</td></tr><tr><td><strong>Total Moonwalk (EVA) Time</strong></td><td>~2.5 hours</td><td>~22 hours</td></tr><tr><td><strong>Distance Covered on Surface</strong></td><td>~250 meters on foot</td><td>~35 km by rover</td></tr><tr><td><strong>Lunar Samples Returned</strong></td><td>~21.5 kg</td><td>~110.5 kg</td></tr><tr><td><strong>Primary Mission Goal</strong></td><td>Prove a crewed landing and return were possible</td><td>Maximize scientific return before the program ended</td></tr><tr><td><strong>Historical Significance</strong> <span class="matrx-pl-muted matrx-pl-small">weight 2</span></td><td>&#9733;&#9733;&#9733;&#9733;&#9733; <span class="matrx-pl-muted">5/5</span></td><td>&#9733;&#9733;&#9733;&#9733;&#9734; <span class="matrx-pl-muted">4/5</span></td></tr></tbody></table></section>"`;

exports[`structured type layouts over real stored rows decision-tree (json) 1f6cd2da-9775-436e-8a5b-d63b4f577c39 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Crow Gift Response Guide</h2><div class="matrx-pl-card matrx-pl-long"><strong>Did the crow leave an object near your feeding spot?</strong><ul><li><em>Yes</em><div class="matrx-pl-card matrx-pl-long"><strong>Is it safe to handle (not sharp or dirty)?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Acknowledge it, leave a peanut in return, keep the routine</strong></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Leave it, photograph it, and continue feeding as normal</strong></div></li></ul></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Keep showing up daily — trust takes weeks, not days</strong></div></li></ul></div></section>"`;

exports[`structured type layouts over real stored rows decision-tree (json) 19bed02c-3089-44fb-92a6-3568677da034 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Which Blue Should I Use?</h2><div class="matrx-pl-card matrx-pl-long"><strong>Is it for a screen (digital)?</strong><ul><li><em>Yes</em><div class="matrx-pl-card matrx-pl-long"><strong>Do you want it to feel calm?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Use a soft sky blue (#7EC8E3)</strong></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Use electric cyan (#00B4D8) for energy</strong></div></li></ul></div></li><li><em>No</em><div class="matrx-pl-card matrx-pl-long"><strong>Is it a formal / professional piece?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Go with deep navy (#1B2A4A)</strong></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Try playful cobalt (#2A6FDB)</strong></div></li></ul></div></li></ul></div></section>"`;

exports[`structured type layouts over real stored rows decision-tree (object) 42f45125-ff7d-4a7a-9715-5ff4f4e1fef7 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Production Incident Triage</h2><div class="matrx-pl-sub"><p>First-responder decision path for a paging alert.</p></div><div class="matrx-pl-card matrx-pl-long"><strong>Are users currently unable to complete a core workflow?</strong><div class="matrx-pl-muted">Core workflows: sign-in, checkout, data write.</div><ul><li><em>Yes</em><div class="matrx-pl-card matrx-pl-long"><strong>Did the impact begin within 30 minutes of a deploy?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Roll back the most recent deploy, then confirm recovery</strong><div>Rollback is faster than root-cause under active impact.</div><div class="matrx-pl-muted matrx-pl-small">10 minutes · priority high</div></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Declare a Sev-1, page the on-call lead, open an incident channel</strong><div>Unknown cause plus active impact warrants full incident response.</div><div class="matrx-pl-muted matrx-pl-small">5 minutes · priority high</div></div></li></ul></div></li><li><em>No</em><div class="matrx-pl-card matrx-pl-long"><strong>Is an error-rate or latency SLO actively burning?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Open a Sev-3 and investigate during business hours</strong><div class="matrx-pl-muted matrx-pl-small">1 hour · priority medium</div></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Silence the alert and file a tuning ticket for its threshold</strong><div>A page with no user impact and no SLO burn is a bad alert.</div><div class="matrx-pl-muted matrx-pl-small">15 minutes · priority low</div></div></li></ul></div></li></ul></div></section>"`;

exports[`structured type layouts over real stored rows decision-tree (object) 2143c43a-14e4-41c6-b354-a5182dc2240a prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">User Usage Check &amp; Cache Routing</h2><div class="matrx-pl-sub"><p>Fast-path asynchronous verification for clear users with synchronous fallbacks on boundary limits.</p></div><div class="matrx-pl-card matrx-pl-long"><strong>Is usage status cached for the user?</strong><ul><li><em>Yes</em><div class="matrx-pl-card matrx-pl-long"><strong>Is cached status &#39;Clear&#39;?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Approve request immediately &amp; dispatch async background cache update</strong><div class="matrx-pl-muted matrx-pl-small">&lt; 1 ms · priority low</div></div></li><li><em>No</em><div class="matrx-pl-card matrx-pl-long"><strong>Is cached status &#39;Stop&#39;?</strong><ul><li><em>Yes</em><div class="matrx-pl-card matrx-pl-long"><strong>Fetch fresh usage synchronously. Is user still over the limit?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Block request (Quota Exceeded) and maintain &#39;Stop&#39; in cache</strong><div class="matrx-pl-muted matrx-pl-small">20-50 ms · priority high</div></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Approve request and update cache with current status (&#39;Clear&#39; or &#39;Near-limit&#39;)</strong><div class="matrx-pl-muted matrx-pl-small">20-50 ms · priority medium</div></div></li></ul></div></li><li><em>No</em><div class="matrx-pl-card matrx-pl-long"><strong>Fetch fresh usage synchronously. Has user now exceeded the limit?</strong><ul><li><em>Yes</em><div class="matrx-pl-card"><strong>&#8594; Block request (Quota Exceeded) and transition cache status to &#39;Stop&#39;</strong><div class="matrx-pl-muted matrx-pl-small">20-50 ms · priority high</div></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Approve request and update cache with latest count</strong><div class="matrx-pl-muted matrx-pl-small">20-50 ms · priority medium</div></div></li></ul></div></li></ul></div></li></ul></div></li><li><em>No</em><div class="matrx-pl-card"><strong>&#8594; Approve request immediately &amp; dispatch async background cache update</strong><div class="matrx-pl-muted matrx-pl-small">&lt; 1 ms · priority low</div></div></li></ul></div></section>"`;

exports[`structured type layouts over real stored rows progress (object) 9834af61-4314-4e3d-b0aa-fe0f8bdb84c5 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Learning Progress</h2><dl class="matrx-pl-kv"><dt>Overall</dt><dd>4 of 9 done · 44%</dd></dl><div class="matrx-pl-bar"><span class="matrx-pl-w45"></span></div><h3>React Fundamentals <span class="matrx-pl-muted matrx-pl-small">3/5 · 60%</span></h3><div class="matrx-pl-bar"><span class="matrx-pl-w60"></span></div><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9745;</span> Components &amp; JSX</li><li><span class="matrx-pl-check">&#9745;</span> Props &amp; State</li><li><span class="matrx-pl-check">&#9745;</span> Event Handling</li><li><span class="matrx-pl-check">&#9744;</span> Lifecycle Methods</li><li><span class="matrx-pl-check">&#9744;</span> Hooks</li></ul><h3>Advanced Topics <span class="matrx-pl-muted matrx-pl-small">1/4 · 25%</span></h3><div class="matrx-pl-bar"><span class="matrx-pl-w25"></span></div><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9745;</span> Context API</li><li><span class="matrx-pl-check">&#9744;</span> Performance Optimization</li><li><span class="matrx-pl-check">&#9744;</span> Testing</li><li><span class="matrx-pl-check">&#9744;</span> Custom Hooks</li></ul></section>"`;

exports[`structured type layouts over real stored rows questionnaire (object) 4b7d2805-12a1-4f59-b788-b3f9792bc54d prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Questionnaire</h2><div class="matrx-pl-card"><strong>Q1: Would you like a deeper breakdown of either topic?</strong><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9744;</span> Cost comparison across all niche options</li><li><span class="matrx-pl-check">&#9744;</span> State-specific permit timeline details</li><li><span class="matrx-pl-check">&#9744;</span> Both</li><li><span class="matrx-pl-check">&#9744;</span> Neither, I&#39;m good for now</li></ul></div></section>"`;

exports[`structured type layouts over real stored rows questionnaire (object) 8f80a43a-1bdf-4f71-a100-3f69ea58c0b5 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Questionnaire</h2><div class="matrx-pl-card"><strong>Q1: What&#39;s your target opening timeline?</strong><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9675;</span> Within 1 month</li><li><span class="matrx-pl-check">&#9675;</span> 1–3 months</li><li><span class="matrx-pl-check">&#9675;</span> 3–6 months</li><li><span class="matrx-pl-check">&#9675;</span> No fixed date yet</li></ul></div><div class="matrx-pl-card"><strong>Q2: What&#39;s your estimated startup budget?</strong><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9675;</span> Under $25k</li><li><span class="matrx-pl-check">&#9675;</span> $25k–$75k</li><li><span class="matrx-pl-check">&#9675;</span> $75k–$150k</li><li><span class="matrx-pl-check">&#9675;</span> Over $150k</li></ul></div><div class="matrx-pl-card"><strong>Q3: Do you already have a location secured?</strong><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9675;</span> Yes, lease signed</li><li><span class="matrx-pl-check">&#9675;</span> In negotiation</li><li><span class="matrx-pl-check">&#9675;</span> Still searching</li><li><span class="matrx-pl-check">&#9675;</span> Planning to start home-based/cottage first</li></ul></div><div class="matrx-pl-card"><strong>Q4: Which best describes your primary product focus?</strong><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9675;</span> Artisan bread</li><li><span class="matrx-pl-check">&#9675;</span> Pastries/viennoiserie</li><li><span class="matrx-pl-check">&#9675;</span> Custom cakes</li><li><span class="matrx-pl-check">&#9675;</span> Mixed menu with coffee</li></ul></div><div class="matrx-pl-card"><strong>Q5: Who is your target customer?</strong><div class="matrx-pl-line"></div><div class="matrx-pl-line"></div></div></section>"`;

exports[`structured type layouts over real stored rows recipe (md) 9aabaca3-b635-4503-a4d0-96b0a2314f6e prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">No-Bake Peanut &amp; Seed Bird Bark</h2><dl class="matrx-pl-kv"><dt>Yields</dt><dd>12 pieces</dd><dt>Prep time</dt><dd>15 minutes</dd><dt>Cook time</dt><dd>10 minutes</dd><dt>Total time</dt><dd>20 minutes</dd></dl><h3>Ingredients</h3><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9744;</span> <strong>1 cup</strong> unsalted peanuts, shelled</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/2 cup</strong> mixed raw seeds (sunflower, pumpkin)</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/2 cup</strong> rolled oats</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/3 cup</strong> honey or unsweetened nut butter (for the human batch only)</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/2 tsp</strong> cinnamon (human batch only)</li></ul><h3>Instructions</h3><ol><li><strong>Separate:</strong> Set aside half the peanuts and seeds plain — this untouched portion is your crow offering (no honey, no salt, no spice).</li><li><strong>Toast:</strong> Warm the oats and remaining seeds in a dry pan over medium heat for 3–4 minutes until fragrant (watch closely — they burn fast). <span class="matrx-pl-muted matrx-pl-small">(4 minutes)</span></li><li><strong>Bind:</strong> Stir in honey or nut butter and cinnamon off the heat until everything clumps together (mixture should be sticky but hold its shape).</li><li><strong>Press:</strong> Spread onto a parchment-lined tray, pressing firmly into a 1/4-inch slab.</li><li><strong>Chill:</strong> Refrigerate 10 minutes, then break into rustic shards. <span class="matrx-pl-muted matrx-pl-small">(10 minutes)</span></li></ol><h3>Notes</h3><p>Keep your shards in an airtight tin for up to a week — and leave the plain peanuts out for your crow at the same time each day. One snack, two species, one beautiful friendship. 🐦‍⬛</p></section>"`;

exports[`structured type layouts over real stored rows recipe (md) 11ea1a98-760b-46b3-847c-0e9cb45d9eff prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Cheetah Speed Energy Bites</h2><dl class="matrx-pl-kv"><dt>Yields</dt><dd>12 bites</dd><dt>Prep time</dt><dd>15 minutes</dd><dt>Cook time</dt><dd>10 minutes</dd><dt>Total time</dt><dd>15 minutes</dd></dl><h3>Ingredients</h3><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9744;</span> <strong>1 cup</strong> rolled oats</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/2 cup</strong> natural peanut butter, room temperature</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/3 cup</strong> honey</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/2 cup</strong> mini chocolate chips (the &quot;cheetah spots&quot;)</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/4 cup</strong> ground flaxseed</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1 tsp</strong> vanilla extract</li><li><span class="matrx-pl-check">&#9744;</span> Pinch of sea salt</li></ul><h3>Instructions</h3><ol><li><strong>Combine:</strong> In a large bowl, stir the oats, flaxseed, and salt together until evenly mixed.</li><li><strong>Bind:</strong> Add the peanut butter, honey, and vanilla. Mix until a sticky dough forms (it should hold together when pressed, not crumble).</li><li><strong>Fold:</strong> Gently fold in the chocolate chips so they speckle the dough like a cheetah&#39;s coat.</li><li><strong>Chill:</strong> Refrigerate the dough for 30 minutes so it firms up and rolls cleanly. <span class="matrx-pl-muted matrx-pl-small">(30 minutes)</span></li><li><strong>Roll:</strong> Scoop tablespoon-sized portions and roll into balls (slightly damp hands prevent sticking).</li><li><strong>Store:</strong> Keep in an airtight container in the fridge for up to a week — perfect fuel for a fast sprint.</li></ol><h3>Notes</h3><p>Fast to make, faster to eat — the perfect snack for anyone chasing cheetah-level energy! 🐆</p></section>"`;

exports[`structured type layouts over real stored rows recipe (object) 93064b41-4a02-47d7-bc62-0536f8aea410 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Butterfly Pea Blue Lemonade</h2><dl class="matrx-pl-kv"><dt>Yields</dt><dd>4 servings</dd><dt>Prep time</dt><dd>15 minutes</dd><dt>Cook time</dt><dd>10 minutes</dd><dt>Total time</dt><dd>15 minutes</dd></dl><h3>Ingredients</h3><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9744;</span> <strong>2 tbsp</strong> dried butterfly pea flowers (the natural blue magic)</li><li><span class="matrx-pl-check">&#9744;</span> <strong>2 cup</strong> s hot water</li><li><span class="matrx-pl-check">&#9744;</span> <strong>3 cup</strong> s cold water</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/2 cup</strong> fresh lemon juice, strained</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/4 cup</strong> honey or simple syrup, to taste</li><li><span class="matrx-pl-check">&#9744;</span> Ice cubes</li><li><span class="matrx-pl-check">&#9744;</span> Lemon slices, for garnish</li></ul><h3>Instructions</h3><ol><li><strong>Steep:</strong> Pour the hot water over the butterfly pea flowers and let sit 5 minutes until deeply, vividly blue. Strain out the flowers. <span class="matrx-pl-muted matrx-pl-small">(5 minutes)</span></li><li><strong>Cool:</strong> Combine the blue tea with the cold water and chill (it should be a rich sapphire color).</li><li><strong>Sweeten:</strong> Stir in the honey or simple syrup until fully dissolved.</li><li><strong>Serve:</strong> Fill glasses with ice and pour in the blue base.</li><li><strong>Watch the magic:</strong> Squeeze in the lemon juice at the table — the acid drops the pH and the drink shifts from blue to purple-pink right before your eyes! (For a two-tone look, add lemon slowly and don&#39;t stir.)</li></ol><h3>Notes</h3><p>Sip slowly and enjoy your color-changing chemistry in a glass — nature&#39;s own mood ring. 💙💜</p></section>"`;

exports[`structured type layouts over real stored rows recipe (object) 86175481-21be-4543-a9d3-2ebc5e2a2769 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Quick Garlic Butter Pasta</h2><dl class="matrx-pl-kv"><dt>Yields</dt><dd>Serves 2</dd><dt>Prep time</dt><dd>5 minutes</dd><dt>Cook time</dt><dd>15 minutes</dd><dt>Total time</dt><dd>20 minutes</dd></dl><h3>Ingredients</h3><ul class="matrx-pl-plain"><li><span class="matrx-pl-check">&#9744;</span> <strong>8 oz</strong> spaghetti</li><li><span class="matrx-pl-check">&#9744;</span> <strong>3 tbsp</strong> butter</li><li><span class="matrx-pl-check">&#9744;</span> <strong>4</strong> cloves garlic, minced</li><li><span class="matrx-pl-check">&#9744;</span> <strong>1/4 cup</strong> grated parmesan</li></ul><h3>Instructions</h3><ol><li><strong>Boil</strong> Cook the spaghetti in salted water until al dente, about 9 minutes. <span class="matrx-pl-muted matrx-pl-small">(9 minutes)</span></li><li><strong>Sizzle</strong> Melt the butter and cook the garlic until fragrant, about 1 minute. <span class="matrx-pl-muted matrx-pl-small">(1 minute)</span></li><li><strong>Toss</strong> Drain the pasta and toss with the garlic butter and parmesan.</li></ol></section>"`;

exports[`structured type layouts over real stored rows research (object) 80db71ea-291f-4e92-93e2-340c383051b3 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Highest-Value DSH (DeepSeek Harness) Plugins for Task Delegation and Agentic Workflows</h2><dl class="matrx-pl-kv"><dt>Scope</dt><dd>DSH plugin ecosystem, Aug 13-23 2026, delegation &amp; agentic-workflow plugins only</dd><dt>Focus</dt><dd>Multi-agent orchestration, subagent delegation, scheduling/loops, workflow governance &amp; sandboxing, memory/context, plugin discovery &amp; safety</dd><dt>Period</dt><dd>August 13-23, 2026 (from DSH open-source release to present)</dd></dl><h3>Executive summary</h3><p>DeepSeek Harness ships subagent delegation, workflows, scheduling, goals and plan mode in the base runtime — so the highest-value third-party plugins are not the ones that add delegation, but the ones that make delegation durable, governable, and resumable. Three plugins define the category: dsh-agent-teams (captain-led teams of continuable sub-agents with dependency-aware task splitting), dsh_workflow (turns one-shot multi-agent dispatch into a saveable, resumable, observable workflow layer), and dsh-workflow-isolate (replaces the WorkflowEngine itself with a QuickJS/WASM sandbox that bounds memory, execution time and child-agent fan-out). Around them sits a supporting tier that determines whether long-running delegation actually works in practice: memory/context plugins to survive context limits across sessions, dsh-approval-gate to keep irreversible operations human-gated, and dsh-loop plus scheduled-session plugins for unattended recurring work. The ecosystem&#39;s dominant risk is not capability but supply chain — plugins execute with the permissions of the dsh process and can run code at install time, while the catalogs indexing them disagree about the ecosystem&#39;s size by a factor of forty.</p><h3>Overview</h3><p>A synthesis of the DeepSeek Harness (dsh) plugin ecosystem, focused specifically on plugins that add multi-agent delegation, orchestration, scheduling, and the memory/governance layers those workflows depend on. Built under a live scraping outage: all evidence is snippet-level (search result descriptions, aggregator listings, README fragments), not full page bodies.</p><h3>Introduction</h3><p>DeepSeek open-sourced the Harness (dsh) on August 13, 2026 under MIT, and it reached roughly 95,000-150,000 GitHub stars within days. Its architecture — &#39;everything is a plugin,&#39; built on the Cordis framework — means the agent loop, tool registry, session log and sandbox are all swappable. That makes the plugin layer, not the model, the place where delegation behavior is actually decided. This report asks:</p><h3>Research questions</h3><ol><li>Which DSH plugins meaningfully extend task delegation and multi-agent orchestration beyond what the base runtime already provides?</li><li>What does the base harness already do natively, so that a plugin is not installed redundantly?</li><li>Which supporting plugins (memory, approval gating, scheduling) determine whether delegated workflows survive long runs?</li><li>What are the safety, maturity and compatibility risks of adopting these plugins during developer preview?</li></ol><h3>Key Research Findings</h3><p class="matrx-pl-muted">Delegation and orchestration plugins, the native baseline, and the supporting layer</p><div class="matrx-pl-card"><h4>dsh-agent-teams is the reference implementation of captain-led delegation</h4><p>The plugin turns the current DSH session into a &#39;captain&#39; that assembles durable sub-agents, splits a goal into dependency-aware tasks, and coordinates members through direct messages. It ships a team protocol, ten coordination tools, persistent state, an automatic shared-task scheduler and a live Web UI — explicitly without requiring a separate workflow engine. Install: dsh plugin --profile web add @nanmicoder/dsh-agent-teams@latest. Config keys documented: stateDir, memberProvider (spawn), memberModel (deepseek-v4), memberMaxDepth (1), maxMembers (8). MIT licensed.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>The distinguishing feature is that members are CONTINUABLE sub-agents that can be woken for focused follow-up turns — the difference between fire-and-forget dispatch and a team you can return to. maxMembers 8 and memberMaxDepth 1 are explicit fan-out bounds, which matters for cost control.</dd><dt>Confidence</dt><dd>HIGH</dd><dt>Primary source</dt><dd>GitHub — NanmiCoder/dsh-agent-teams</dd><dt>Implications</dt><dd>Sets the de facto interface for team-style delegation on DSH; competing plugins will likely be judged against its ten-tool coordination protocol.</dd><dt>Sources</dt><dd><a href="https://github.com/NanmiCoder/dsh-agent-teams">https://github.com/NanmiCoder/dsh-agent-teams</a><br><a href="https://deepseek-harness-plugin.com/plugins/dsh-agent-teams/">https://deepseek-harness-plugin.com/plugins/dsh-agent-teams/</a></dd></dl></div><div class="matrx-pl-card"><h4>dsh_workflow adds the governance layer that raw multi-agent dispatch lacks</h4><p>Described as bringing Claude Code&#39;s UltraCode mode to DSH: it upgrades one-shot multi-agent dispatch into a workflow layer that is generatable, savable, governable, observable and resumable. MIT licensed. An independent &#39;best plugins&#39; roundup names dsh_workflow one of three additions most likely to change what a new DSH setup can actually accomplish, alongside ModLens and dsh-browser.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>Those five adjectives map exactly onto the failure modes of agentic delegation: you cannot reuse a run, you cannot see inside it, and you cannot resume it after a crash. This is the plugin that addresses reuse and recovery rather than raw parallelism.</dd><dt>Confidence</dt><dd>MEDIUM</dd><dt>Primary source</dt><dd>deepseek-harness-plugin.com — dsh_workflow (maintainer: icetomoyo)</dd><dt>Implications</dt><dd>As DSH runs get longer and more expensive, resumability becomes the binding requirement — a workflow that cannot resume must be paid for twice.</dd><dt>Sources</dt><dd><a href="https://deepseek-harness-plugin.com/plugins/dsh_workflow/">https://deepseek-harness-plugin.com/plugins/dsh_workflow/</a></dd></dl></div><div class="matrx-pl-card"><h4>dsh-workflow-isolate replaces the WorkflowEngine itself with a bounded sandbox</h4><p>An alternative WorkflowEngine provider for DSH 0.1.0-rc.7 that runs model-written orchestration inside fresh QuickJS/WASM runtimes behind a JSON-only host bridge, with bounded memory, bounded execution time and bounded child-agent fan-out.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>This is the only plugin found that treats model-written orchestration code as untrusted by default. Bounded child-agent fan-out is a direct financial control: it caps runaway recursive spawning, the most expensive failure mode in agentic delegation.</dd><dt>Confidence</dt><dd>MEDIUM</dd><dt>Primary source</dt><dd>GitHub — 0xsline/awesome-deepseek-harness</dd><dt>Implications</dt><dd>Demonstrates the payoff of &#39;everything is a plugin&#39; — the orchestration engine is replaceable without patching the harness. Expect security-conscious teams to standardize on sandboxed engine providers.</dd><dt>Sources</dt><dd><a href="https://github.com/0xsline/awesome-deepseek-harness">https://github.com/0xsline/awesome-deepseek-harness</a></dd></dl></div><div class="matrx-pl-card"><h4>The base harness already delegates — including to Claude Code and Codex</h4><p>Standard mode ships file editing, shell, file and web search, skills, planning, goals, subagents and workflows natively. Sessions, sandboxes, storage, loops and scheduling are all Cordis plugins in the base bundle. Everything the model sees — including subagent scheduling and every context injection — is recorded in an append-only session log. The harness also ships two subagent providers that delegate work directly to Anthropic&#39;s Claude Code and OpenAI&#39;s Codex, resolving each binary from the host PATH.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>This reframes the whole plugin question. Delegation is not missing, so a plugin only earns its install if it adds durability, governance, sandboxing or observability on top. It also makes DSH an orchestrator ABOVE rival agents rather than merely a competitor to them.</dd><dt>Confidence</dt><dd>HIGH</dd><dt>Primary source</dt><dd>deepseek.com/harness/en/ (official developer preview page)</dd><dt>Implications</dt><dd>The append-only session log is the substrate that makes third-party observability and replay plugins possible at all.</dd><dt>Sources</dt><dd><a href="https://deepseek.com/harness/en/">https://deepseek.com/harness/en/</a><br><a href="https://thenewstack.io/deepseek-harness-open-source-plugins/">https://thenewstack.io/deepseek-harness-open-source-plugins/</a><br><a href="https://venturebeat.com/technology/deepseek-harness-launches-as-open-source-rival-to-claude-code-alongside-v4-pro-on-api-with-higher-prices">https://venturebeat.com/technology/deepseek-harness-launches-as-open-source-rival-to-claude-code-alongside-v4-pro-on-api-with-higher-prices</a></dd></dl></div><div class="matrx-pl-card"><h4>Scheduling and approval gating are what make unattended delegation survivable</h4><p>dsh-loop adds scheduled loops via a /loop command, a loop tool and an activity status bar. A separate scheduling plugin runs coding tasks in fresh agent sessions on a schedule, with tasks created and managed either by the user or by the agents themselves. dsh-approval-gate provides risk-gated approval automation that routes irreversible operations to human approval. hermes-dsh-collab adds dispatch-spec templates, model-tier routing, orchestrator-run quality gates and a git single-writer rule. fullstack-expert adds evidence-first gates (fullstack_plan / fullstack_check) with explicit pass/fail/unknown checks, MIT.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>Agents that schedule their own future work plus agents that can perform irreversible operations is the combination that produces unrecoverable incidents. The git single-writer rule in hermes-dsh-collab addresses the specific failure of concurrent sub-agents writing the same repository.</dd><dt>Confidence</dt><dd>MEDIUM</dd><dt>Primary source</dt><dd>GitHub — Alex-Yanggg/awesome-DSH-plugin</dd><dt>Implications</dt><dd>Approval gating and single-writer discipline will likely migrate from plugins into recommended defaults as multi-agent runs become routine.</dd><dt>Sources</dt><dd><a href="https://github.com/Alex-Yanggg/awesome-DSH-plugin">https://github.com/Alex-Yanggg/awesome-DSH-plugin</a></dd></dl></div><div class="matrx-pl-card"><h4>Memory and context compression are the real constraint on long delegated runs</h4><p>Memory &amp; Context is one of the largest categories (95-186 plugins depending on the index). Notable entries: Mnemon-powered cross-agent local-first memory with graph-based intent-aware recall in a single binary with zero API keys; a cross-session engine combining a SQLite store with a human-editable Markdown mirror, offline semantic search and seven memory tools; billion-context-dsh, which implements model-driven Active Context Pruning where the model decides when and what to compress; and a token-auditing plugin providing live monetary cost estimation, dynamic model routing and automatic context-compaction gating.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>Delegated multi-agent work multiplies context consumption across members. Without cross-session memory and compression, a captain loses the thread exactly when a long task matters most — and the cost-auditing plugins are the only visibility into what a fan-out actually spent.</dd><dt>Confidence</dt><dd>MEDIUM</dd><dt>Primary source</dt><dd>dsh-plugin.org and awesome-dsh-plugin.com category indexes</dd><dt>Implications</dt><dd>Expect memory to consolidate around a few local-first, agent-portable stores rather than per-harness silos.</dd><dt>Sources</dt><dd><a href="https://dsh-plugin.org/plugins">https://dsh-plugin.org/plugins</a><br><a href="https://awesome-dsh-plugin.com/">https://awesome-dsh-plugin.com/</a><br><a href="https://deepseekharness.io/">https://deepseekharness.io/</a></dd></dl></div><div class="matrx-pl-card"><h4>Plugin installation is an unreviewed supply-chain risk</h4><p>Directory pages carry an explicit warning that plugins run with the permissions of your dsh process and may execute code at install time, recommending source review and pinning a commit hash (dsh plugin add github:owner/repo#commit) for reproducible installs. Community catalogs state plainly that they are not official DeepSeek products and do not represent DeepSeek review or endorsement, and that DSH is in developer preview where plugin specs and compatibility rules may change rapidly. One plugin, upstream-radar, exists specifically to monitor DSH plugin dependencies for OSV vulnerabilities and compatibility drift.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>The threat model is inverted from normal package managers: these plugins are handed to an agent that already has shell access and filesystem write. dsh-workflow-isolate&#39;s sandboxing and dsh-approval-gate&#39;s human gates are the mitigations, not optional polish.</dd><dt>Confidence</dt><dd>HIGH</dd><dt>Primary source</dt><dd>deepseek-harness-plugin.com install-page safety notice</dd><dt>Implications</dt><dd>Commit pinning and dependency monitoring will become table stakes before enterprise adoption is defensible.</dd><dt>Sources</dt><dd><a href="https://deepseek-harness-plugin.com/plugins/dsh-plugins/">https://deepseek-harness-plugin.com/plugins/dsh-plugins/</a><br><a href="https://github.com/0326/dsh-plugin-market">https://github.com/0326/dsh-plugin-market</a></dd></dl></div><div class="matrx-pl-card"><h4>Discovery is fragmented across at least a dozen competing catalogs</h4><p>There is no official marketplace; discovery runs through the GitHub dsh-plugin topic, which a dozen-plus third-party catalogs index independently — deepseek1024.com, dshplugin.dev, dsh-plugin.market, dshfind.com, findharness.com, dshmarketplace.dev, dsh-plugin.org, awesome-dsh-plugin.com, deepseekplugin.org, dshpluginstore.com and several awesome-lists. Reported catalog sizes range from 154 to 6,553. Some are in-harness plugins themselves (dsh-market, dsh-plugin-marketplace) that surface browsing and one-click install inside the Web UI.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>Discovery quality, not plugin availability, is the current bottleneck. Catalogs that publish an explicit scoring formula and last-push dates are materially more useful than star-ranked dumps.</dd><dt>Confidence</dt><dd>HIGH</dd><dt>Primary source</dt><dd>Comparative review of DSH plugin directories</dd><dt>Sources</dt><dd><a href="https://github.com/topics/dsh-plugin">https://github.com/topics/dsh-plugin</a><br><a href="https://dshmarketplace.dev/">https://dshmarketplace.dev/</a><br><a href="https://deepseekplugin.org/en">https://deepseekplugin.org/en</a></dd></dl></div><h3>Convergent themes</h3><table><thead><tr><th>Theme</th><th>Description</th></tr></thead><tbody><tr><td><strong>Delegation is native; plugins sell durability and governance</strong></td><td>Official documentation and every independent write-up agree that subagents, workflows, scheduling and goals ship in the base harness. Independently, the top-rated third-party plugins all describe themselves in terms of persistence, resumability, observability and bounds — not in terms of adding delegation itself.</td></tr><tr><td><strong>Bounded fan-out is the recurring cost-control primitive</strong></td><td>dsh-agent-teams caps members at 8 and depth at 1; dsh-workflow-isolate bounds child-agent fan-out, memory and execution time; a token-auditing plugin adds live cost estimation and compaction gating. Independent projects converge on the same insight: uncapped recursive spawning is the ecosystem&#39;s dominant financial risk.</td></tr><tr><td><strong>Install-time code execution is acknowledged across catalogs</strong></td><td>Multiple unaffiliated directories carry near-identical warnings about process-level permissions and install-time code execution, and independently recommend commit pinning. This is a settled consensus, not one project&#39;s caution.</td></tr><tr><td><strong>Local-first, cross-agent memory is the preferred architecture</strong></td><td>Mnemon, the SQLite+Markdown engine, and the portable Markdown-native memory layer all independently choose local-first, human-readable, agent-portable storage over harness-specific cloud stores.</td></tr></tbody></table><h3>Conflicting evidence</h3><dl class="matrx-pl-kv"><dt>Resolution</dt><dd>Treat catalog counts as measures of indexing policy, not ecosystem size: hand-curated stores count installable, manifest-validated packages while auto-syncing crawlers count every repository carrying the dsh-plugin topic, including forks, skills and unrelated projects that added the tag for visibility. Treat aggregator star counts as unreliable — several appear to attribute a parent repository&#39;s stars to a subdirectory plugin. Verify adoption on the GitHub repository itself, and weight last-push date over stars.</dd><dt>Disagreement</dt><dd>The size of the DSH plugin ecosystem, and the adoption signals attached to individual plugins.</dd><dt>Perspectives</dt><dd>Catalog counts for the same ecosystem over the same week span 154 (dshplugin.io), 800+ (dshplugin.store), 1,837 (awesome-dsh-plugin.com), 2,000+ (dsh-plugin.org), 3,100-3,162 (several), 3,588 (deepseekplugin.org), 4,731 (dshmarketplace.dev), 6,396 (dsh-plugin-directory.online) and 6,553 (deepseek1024.com) — a factor of over forty. Star counts are similarly incoherent: one aggregator lists a memory plugin at 31,434 stars and a diagram skill at 14,924, figures comparable to the harness itself.</dd></dl><h3>Outlook</h3><h4>Short term</h4><ul><li>Rapid churn: DSH is explicitly in developer preview and plugin specs may change without notice — dsh-workflow-isolate already pins itself to 0.1.0-rc.7</li><li>Consolidation among the dozen-plus catalogs, with curated, formula-publishing directories outlasting auto-synced dumps</li><li>Approval gating and sandboxed workflow engines moving from optional plugins toward recommended defaults</li><li>Continued absence of an official marketplace, keeping the GitHub dsh-plugin topic as the canonical index</li></ul><h4>Medium term</h4><ul><li>A stable orchestration interface emerging, most likely modeled on the agent-teams captain/member protocol</li><li>Memory consolidating around two or three portable, cross-agent, local-first stores rather than per-plugin silos</li><li>Cross-harness delegation becoming routine as MCP bridges (dsh-harness-mcp-server) let any MCP client drive DSH and vice versa</li><li>Dependency and vulnerability monitoring (upstream-radar-style) becoming a prerequisite for team adoption</li></ul><h4>Long term</h4><ul><li>The harness layer commoditizing, with competitive differentiation shifting entirely to plugin composition and profile sharing (dshp-style portable profiles)</li><li>Sandboxed, resource-bounded execution of model-written orchestration becoming the assumed default rather than a specialist choice</li><li>Multi-vendor agent teams — DeepSeek captains delegating to Claude Code and Codex members — as a normal architecture rather than a novelty</li></ul><h3>Challenges</h3><div class="matrx-pl-card"><h4>Plugins execute with full agent permissions</h4><p>A DSH plugin runs with the permissions of the dsh process — which already has shell access and filesystem write — and may execute code at install time.</p><dl class="matrx-pl-kv"><dt>Category</dt><dd>technical</dd><dt>Research gaps</dt><dd>No signing, no capability manifests enforced at runtime, and no official review process for community plugins.</dd><dt>Current solutions</dt><dd>Commit-hash pinning, source review before install, dsh-approval-gate for irreversible operations, dsh-workflow-isolate&#39;s QuickJS/WASM sandbox, upstream-radar OSV monitoring.</dd></dl></div><div class="matrx-pl-card"><h4>Developer-preview compatibility drift</h4><p>Plugin specs and compatibility rules are changing rapidly, and orchestration-layer plugins bind to specific release candidates.</p><dl class="matrx-pl-kv"><dt>Category</dt><dd>technical</dd><dt>Research gaps</dt><dd>No published compatibility matrix mapping plugin versions to harness versions.</dd><dt>Current solutions</dt><dd>Pinning package versions and commit hashes; catalogs surfacing compatibility status and last-push dates.</dd></dl></div><div class="matrx-pl-card"><h4>Unverifiable adoption signals</h4><p>Star counts and catalog sizes reported by aggregators are internally inconsistent by more than an order of magnitude.</p><dl class="matrx-pl-kv"><dt>Category</dt><dd>other</dd><dt>Research gaps</dt><dd>No neutral, audited registry of installs or active usage.</dd><dt>Current solutions</dt><dd>A few directories publish explicit 100-point scoring formulas and per-plugin breakdowns rather than raw star rankings.</dd></dl></div><div class="matrx-pl-card"><h4>Concurrent sub-agents writing shared state</h4><p>Multi-member teams operating on one repository can collide on writes.</p><dl class="matrx-pl-kv"><dt>Category</dt><dd>technical</dd><dt>Research gaps</dt><dd>No standard locking or merge-conflict protocol across orchestration plugins.</dd><dt>Current solutions</dt><dd>hermes-dsh-collab&#39;s git single-writer rule; agent-teams&#39; dependency-aware task graph; per-session isolated sidebars and sandboxes.</dd></dl></div><h3>Recommendations</h3><table><thead><tr><th>For</th><th>Recommendation</th></tr></thead><tbody><tr><td>general</td><td>Before installing anything, run the base harness in Standard mode — subagents, workflows, goals, planning and scheduling are already present, and roughly half of candidate plugins turn out to be redundant.</td></tr><tr><td>general</td><td>For team-style delegation start with dsh-agent-teams, and keep the shipped bounds (maxMembers 8, memberMaxDepth 1) until you have measured the cost of a real fan-out.</td></tr><tr><td>general</td><td>Add dsh_workflow only once you are re-running the same orchestration more than once — its value is saving, resuming and observing runs, which one-off tasks never exercise.</td></tr><tr><td>industry</td><td>Pair any delegation plugin with dsh-approval-gate and a token-auditing plugin before running unattended or scheduled work; agents that schedule their own tasks and can perform irreversible operations is the combination that produces unrecoverable incidents.</td></tr><tr><td>industry</td><td>Adopt dsh-workflow-isolate where model-written orchestration runs against anything of value — it is the only surveyed option that bounds memory, execution time and child-agent fan-out at the engine level.</td></tr><tr><td>industry</td><td>Pin every plugin to a commit hash, review the source before install, and run upstream-radar-style dependency monitoring; treat install-time code execution as the default threat model rather than an edge case.</td></tr><tr><td>researchers</td><td>Verify adoption on the GitHub repository itself and weight last-push date above star count — aggregator star figures in this ecosystem are demonstrably unreliable.</td></tr><tr><td>policymakers</td><td>Publish a compatibility matrix and a capability manifest standard for DSH plugins; the absence of both is the clearest gap between the current ecosystem and safe enterprise adoption.</td></tr></tbody></table><h3>Conclusion</h3><p>For task delegation and agentic workflows, DSH&#39;s plugin layer divides cleanly into three tiers. The base harness already delivers delegation, so tier one is the orchestration upgrades that make it durable — dsh-agent-teams for continuable captain-led teams, dsh_workflow for resumable governed runs, dsh-workflow-isolate for bounded sandboxed execution. Tier two is the survival layer that decides whether long runs actually complete: cross-session memory, context compression, cost auditing, approval gating and single-writer discipline. Tier three is discovery and safety hygiene, where the ecosystem is weakest — no official marketplace, catalogs disagreeing by a factor of forty, and plugins that execute code at install time with full agent permissions.</p><h3>Key takeaways</h3><ul><li>Delegation ships natively — install a plugin only for durability, governance, sandboxing or observability.</li><li>dsh-agent-teams, dsh_workflow and dsh-workflow-isolate are the three that genuinely extend the delegation model.</li><li>Bounded fan-out is the single most important cost and safety control; keep the default caps.</li><li>Memory and context compression, not orchestration, are what break long multi-agent runs.</li><li>Pin commits and gate irreversible operations — plugins run with your agent&#39;s full permissions.</li></ul><h3>Methodology</h3><dl class="matrx-pl-kv"><dt>Search Strategy</dt><dd>Brave search across eight topic keywords plus three targeted probe queries on delegation, orchestration, scheduling and memory; official DeepSeek documentation, GitHub repositories and READMEs, aggregator catalogs, and independent technology press (The New Stack, VentureBeat, DataCamp, Composio).</dd><dt>Analysis Framework</dt><dd>Three-tier capability model (orchestration / survival layer / discovery-safety), assessed against what the base harness already provides natively, with explicit separation of verifiable mechanics from unverifiable adoption metrics.</dd><dt>Selection Criteria</dt><dd>Plugins mechanically relevant to delegation or agentic workflow, with a named maintainer and a resolvable GitHub or npm identity. Aggregator-only claims with no upstream repository were excluded. Claims corroborated by two or more independent sources were rated HIGH.</dd></dl><h3>Source quality</h3><dl class="matrx-pl-kv"><dt>Peer Reviewed</dt><dd>0</dd><dt>Government Pubs</dt><dd>0</dd><dt>Industry Reports</dt><dd>6</dd><dt>Expert Interviews</dt><dd>0</dd></dl><h3>Limitations</h3><ul><li>CRITICAL: zero full page bodies were retrieved. The platform&#39;s page-fetch layer failed on 364 of 364 web scrape attempts (proxy_error), and two independent probes returned zero page bodies. Every claim here rests on search snippets, aggregator listings and README fragments — quotes are short and no source was read end to end.</li><li>No plugin was installed, executed or benchmarked. All capability claims are as-described by maintainers and directories, not verified behavior.</li><li>Adoption metrics are unreliable: aggregator star counts are internally inconsistent and several appear to misattribute parent-repository stars.</li><li>The subject is roughly ten days old and in developer preview; specific version pins (e.g. 0.1.0-rc.7) and install commands will age quickly.</li><li>Category coverage is skewed toward English-language sources; a substantial portion of this ecosystem is documented in Chinese and is underrepresented here.</li></ul></section>"`;

exports[`structured type layouts over real stored rows research (object) b65a9b0e-6ed0-4910-8ffe-08ebb0f97c73 prints as its layout 1`] = `"<section class="matrx-pl"><h2 class="matrx-pl-title">Grid-Scale Energy Storage: State of the Field 2026</h2><dl class="matrx-pl-kv"><dt>Scope</dt><dd>Grid-scale stationary storage, 2023-2026 literature</dd><dt>Focus</dt><dd>Battery chemistry, storage economics, grid integration</dd><dt>Period</dt><dd>2023-2026</dd></dl><h3>Executive summary</h3><p>Storage costs continue to fall while duration requirements rise. Iron-air and sodium-ion chemistries moved from lab to pilot deployment, and long-duration economics now hinge on capacity-market reform more than on cell cost.</p><h3>Overview</h3><p>A synthesis of recent research on grid-scale energy storage technologies, spanning lithium-ion alternatives, flow batteries, and long-duration storage economics.</p><h3>Introduction</h3><p>As renewable penetration passes 40 percent in leading grids, storage shifts from arbitrage asset to reliability backbone. This report reviews what the recent literature establishes, where evidence conflicts, and what remains open.</p><h3>Research questions</h3><ol><li>Which post-lithium chemistries are closest to bankable grid deployment?</li><li>How do long-duration storage economics change under high renewable penetration?</li><li>What regulatory changes most affect storage revenue stacking?</li></ol><h3>Key Research and Discoveries</h3><p class="matrx-pl-muted">Chemistry and deployment findings</p><div class="matrx-pl-card"><h4>Iron-air pilots reached grid interconnection</h4><p>Three iron-air installations totaling 45 MW cleared interconnection and delivered 100-hour discharge in field conditions, at a reported cost of 20 USD per kWh of capacity.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>First field evidence that multi-day storage can undercut gas peakers on capacity cost.</dd><dt>Confidence</dt><dd>HIGH</dd><dt>Primary source</dt><dd>Journal of Power Sources (2025)</dd><dt>Implications</dt><dd>If round-trip efficiency improves past 50 percent, iron-air becomes the default multi-day asset in high-wind grids.</dd><dt>Sources</dt><dd><a href="https://example.com/iron-air-pilot">https://example.com/iron-air-pilot</a></dd></dl></div><div class="matrx-pl-card"><h4>Sodium-ion supply chains localized faster than forecast</h4><p>Sodium-ion cell production outside China tripled year over year, driven by cathode plants co-located with soda-ash production.</p><dl class="matrx-pl-kv"><dt>Significance</dt><dd>Reduces geopolitical concentration risk that constrained lithium-ion procurement.</dd><dt>Confidence</dt><dd>MEDIUM</dd><dt>Primary source</dt><dd>Nature Energy (2026)</dd><dt>Implications</dt><dd>Expect sodium-ion to take the 2-6 hour duration segment on cost by 2028.</dd></dl></div><h3>Convergent themes</h3><table><thead><tr><th>Theme</th><th>Description</th></tr></thead><tbody><tr><td><strong>Duration is the new cost axis</strong></td><td>Across chemistries, papers converge on duration-adjusted cost (USD per kWh-cycle) replacing raw capex as the deciding metric.</td></tr><tr><td><strong>Market design lags technology</strong></td><td>Multiple studies find capacity markets undervalue storage longer than 4 hours, independent of chemistry.</td></tr></tbody></table><h3>Conflicting evidence</h3><dl class="matrx-pl-kv"><dt>Resolution</dt><dd>Most recent reviews treat the 4-hour segment as lithium-locked while conceding everything longer to alternatives.</dd><dt>Disagreement</dt><dd>Whether lithium-ion cost declines will outpace alternative chemistries through 2030.</dd><dt>Perspectives</dt><dd>Techno-economic models project continued 8 percent annual declines; supply-chain analyses argue raw-material floors arrive by 2028.</dd></dl><h3>Outlook</h3><h4>Short term</h4><ul><li>Sodium-ion enters commercial 2-6 hour deployments</li><li>First bankable 100-hour iron-air contracts signed</li></ul><h4>Medium term</h4><ul><li>Capacity-market reforms price duration explicitly</li><li>Hybrid plants pairing storage chemistries become standard</li></ul><h4>Long term</h4><ul><li>Seasonal storage economics close for high-latitude grids</li></ul><h3>Challenges</h3><div class="matrx-pl-card"><h4>Round-trip efficiency of metal-air systems</h4><p>Iron-air round-trip efficiency remains below 45 percent, limiting use to low-cycle applications.</p><dl class="matrx-pl-kv"><dt>Category</dt><dd>technical</dd><dt>Research gaps</dt><dd>No published pathway past 55 percent at system scale.</dd><dt>Current solutions</dt><dd>Electrolyte additives and electrode texturing pilots.</dd></dl></div><div class="matrx-pl-card"><h4>Interconnection queue backlogs</h4><p>Storage projects wait a median of 3.5 years for interconnection studies in US markets.</p><dl class="matrx-pl-kv"><dt>Category</dt><dd>regulatory</dd></dl></div><h3>Recommendations</h3><table><thead><tr><th>For</th><th>Recommendation</th></tr></thead><tbody><tr><td>researchers</td><td>Prioritize round-trip efficiency research for metal-air chemistries over further capex reduction.</td></tr><tr><td>industry</td><td>Contract multi-chemistry portfolios rather than betting a single storage duration segment.</td></tr><tr><td>policymakers</td><td>Reform capacity accreditation to value duration beyond 4 hours explicitly.</td></tr><tr><td>general</td><td>Expect grid electricity reliability economics to shift visibly by 2028.</td></tr></tbody></table><h3>Conclusion</h3><p>The storage field has moved from a single-chemistry cost race to a duration-segmented market. Research attention is shifting accordingly, from cell chemistry to system economics and market design.</p><h3>Key takeaways</h3><ul><li>Duration-adjusted cost is the deciding metric, not raw capex.</li><li>Iron-air and sodium-ion are field-proven, not speculative.</li><li>Market design is now the binding constraint, not technology.</li></ul><h3>Methodology</h3><dl class="matrx-pl-kv"><dt>Search Strategy</dt><dd>Systematic search of peer-reviewed energy journals plus grid-operator technical reports, 2023-2026.</dd><dt>Analysis Framework</dt><dd>Duration-segmented comparison with confidence grading per finding.</dd><dt>Selection Criteria</dt><dd>Field data or validated techno-economic models; lab-only results excluded.</dd></dl><h3>Source quality</h3><dl class="matrx-pl-kv"><dt>Peer Reviewed</dt><dd>24</dd><dt>Government Pubs</dt><dd>7</dd><dt>Industry Reports</dt><dd>11</dd><dt>Expert Interviews</dt><dd>4</dd></dl><h3>Limitations</h3><ul><li>Chinese-language deployment data underrepresented.</li><li>Cost figures self-reported by vendors for pilot projects.</li></ul></section>"`;

