pnignore-workspace-root-check=true
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=true
legacy-peer-deps=true
public-hoist-pattern[]=@heroui/*  # Added for HeroUI compatibility

# Silence deprecation warnings
loglevel=error

# Prevent installation of deprecated packages by default
no-deprecated=true

# Enable installation of optional dependencies
optional=true
# Prune orphaned package versions on EVERY install (pnpm default waits 7 days). Our @ai-matrx
# packages publish dozens of versions a day; without this Vercel's cached node_modules grew
# 4 -> 12 GB between prunes and cache save/upload took ~2.5 min per build (2026-10-08).
modules-cache-max-age=0
