> {\n      if (host === null) {\n        throw new Error(\"[@ai-matrx/messaging] startDirect called before the host was ready.\");\n      }\n      const id = await host.engine.startDirectConversation(otherUserId);\n      select(id);\n      return id;\n    },\n  };\n}\n\nexport interface UseConversationResult {\n  summary: ConversationSummary | null;\n  thread: ConversationThread | null;\n  messages: readonly Message[];\n  participants: readonly UserSummary[];\n  /** True only while the first read is in flight — false once it failed. */\n  isLoading: boolean;\n  /**\n   * Why the conversation could not be read, or `null`. `error.cause` is the\n   * raw database error, for hosts that classify access failures themselves.\n   */\n  error: MessagingError | null;\n  /**\n   * True when the conversation does not exist or this user may not read it.\n   * Render the host's access surface — never \"No messages yet\".\n   */\n  unavailable: boolean;\n  hasMoreOlder: boolean;\n  loadOlder: () => void;\n  pending: readonly OutboxEntry[];\n  retry: (entryId: string) => void;\n  discard: (entryId: string) => void;\n  edit: (messageId: Message[\"id\"], content: string) => Promise<void>;\n  remove: (messageId: Message[\"id\"], forEveryone: boolean) => Promise<void>;\n}\n\nexport function useConversation(id: ConversationId | null): UseConversationResult {\n  const host = useMessagingHost();\n  const snapshot = useMessagingSnapshot();\n  const [outboxTick, setOutboxTick] = useState(0);\n\n  // The conversation channel is opened by the engine, and closed when this hook\n  // stops caring — a leaked subscription per visited thread is otherwise the\n  // slow leak nobody notices until the tab is an hour old.\n  useEffect(() => {\n    if (host === null || id === null) return undefined;\n    void host.engine.openConversation(id);\n    return () => {\n      host.engine.closeConversation(id);\n    };\n  }, [host, id]);\n\n  useEffect(() => {\n    const timer = setInterval(() => setOutboxTick