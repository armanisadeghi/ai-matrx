readonly update: (\n    change: (current: ComposerSessionSnapshot) => ComposerSessionSnapshot,\n  ) => void;\n}\n\nconst EMPTY_COMPOSER_SESSION: ComposerSessionSnapshot = {\n  drafts: {},\n  replies: {},\n  additions: {},\n};\nconst emptyComposerSnapshot = (): ComposerSessionSnapshot => EMPTY_COMPOSER_SESSION;\nconst subscribeToNothing = (): (() => void) => () => undefined;\nconst composerSessions = new WeakMap<MessagingEngine, ComposerSessionStore>();\nconst composerStorageFailures = new WeakSet<MessagingEngine>();\n\nfunction composerStorageKey(engine: MessagingEngine): string {\n  return `ai-matrx.messaging.composer.${engine.identity.userId}`;\n}\n\nfunction readComposerSession(engine: MessagingEngine): ComposerSessionSnapshot {\n  try {\n    if (typeof sessionStorage === \"undefined\") return EMPTY_COMPOSER_SESSION;\n    const serialized = sessionStorage.getItem(composerStorageKey(engine));\n    if (serialized === null) return EMPTY_COMPOSER_SESSION;\n    const parsed: unknown = JSON.parse(serialized);\n    if (typeof parsed !== \"object\" || parsed === null || Array.isArray(parsed)) {\n      throw new Error(\"saved composer state was not an object\");\n    }\n    const source = parsed as Record<string, unknown>;\n    const drafts: Record<string, string> = {};\n    if (typeof source[\"drafts\"] === \"object\" && source[\"drafts\"] !== null) {\n      for (const [id, value] of Object.entries(source[\"drafts\"])) {\n        if (typeof value === \"string\") drafts[id] = value;\n      }\n    }\n    const replies: Record<string, Message | null> = {};\n    if (typeof source[\"replies\"] === \"object\" && source[\"replies\"] !== null) {\n      for (const [id, value] of Object.entries(source[\"replies\"])) {\n        if (value === null) replies[id] = null;\n        else replies[id] = projectBroadcastMessage(value);\n      }\n    }\n    const additions: Record<string, readonly ComposerAttachment[]> = {};\n    if (typeof source[\"additions\"] === \"object\" && source[\"additions\"] !== null) {\n      for (const [id, value] of Object.entries(source[\"additions\"])) {\n        if (!Array.isArray(value)) continue;\n        additions[id] = value.filter((item): item is ComposerAttachment => {\n          if (typeof item !== \"object\" || item === null || Array.isArray(item)) return false;\n          const record = item as Record<string, unknown>;\n          return typeof record[\"id\"] === \"string\" && typeof record[\"label\"] === \"string\";\n        });\n      }\n    }\n    return { drafts, replies, additions };\n  } catch (error) {\n    if (!composerStorageFailures.has(engine)) {\n      composerStorageFailures.add(engine);\n      engine.reportDiagnostic({\n        level: \"warn\",\n        message: `A saved message draft could not be restored: ${String((error as Error)?.message ?? error)}`,\n        remedy: \"The current draft remains usable. Re-add any missing attachments before sending.\",\n      });\n    }\n    return EMPTY_COMPOSER_SESSION;\n  }\n}\n\nfunction writeComposerSession(engine: MessagingEngine, snapshot: ComposerSessionSnapshot): void {\n  try {\n    if (typeof sessionStorage === \"undefined\") return;\n    sessionStorage.setItem(composerStorageKey(engine), JSON.stringify(snapshot));\n  } catch (error) {\n    if (!composerStorageFailures.has(engine)) {\n      composerStorageFailures.add(engine);\n      engine.reportDiagnostic({\n        level: \"warn\",\n        message: `The current message draft could not be saved for reload recovery: ${String((error as Error)?.message ?? error)}`,\n        remedy: \"Keep this tab open until the message is sent, or copy the draft before reloading.\",\n      });\n    }\n  }\n}\n\nfunction getComposerSession(engine: MessagingEngine): ComposerSessionStore {\n  const existing = composerSessions.get(engine);\n  if (existing !== undefined) return existing;\n  let snapshot = readComposerSession(engine);\n  const listeners = new Set<() => void>();\n  const store: ComposerSessionStore = {\n    getSnapshot: () => snapshot,\n    subscribe: (listener) => {\n      listeners.add(listener);\n      return () => listeners.delete(listener);\n    },\n    update: (change) => {\n      snapshot = change(snapshot);\n      writeComposerSession(engine, snapshot);\n      listeners.forEach((listener) => listener());\n    },\n  };\n  composerSessions.set(engine, store);\n  return store;\n}\n\nexport interface UseComposerResult {\n  additions: readonly ComposerAttachment[];\n  add: (item: ComposerAttachment) => void;\n  removeAddition: (id: string) => void;\n  value: string;\n  setValue: (value: string) => void;\n  canSend: boolean;\n  send: () => void;\n  /** Call on EVERY keystroke; the typing lifecycle is entirely inside. */\n  onKeystroke: () => void;\n  replyTo: Message | null;\n  setReplyTo: (message: Message | null) => void;\n}\n\n/**\n * The composer's state. `value` lives here so a draft SURVIVES a re-render and\n * a conversation switch-and-back — losing a half-typed message on a re-render\n * is the same defect as losing a sent one, one step earlier.\n */\nexport function useComposer(conversationId: ConversationId | null): UseComposerResult {\n  const host = useMessagingHost();\n  const session = host === null ? null : getComposerSession(host.engine);\n  const composer = useSyncExternalStore(\n    session?.subscribe ?? subscribeToNothing,\n    session?.getSnapshot ?? emptyComposerSnapshot,\n    emptyComposerSnapshot,\n  );\n  const replyTo = conversationId === null ? null : (composer.replies[conversationId] ?? null);\n  const additions = conversationId === null ? [] : (composer.additions[conversationId] ?? []);\n  const setReplyTo = (message: Message | null) => {\n    if (conversationId !== null) session?.update(current => ({\n      ...current,\n      replies: { ...current.replies, [conversationId]: message },\n    }));\n  };\n  const value = conversationId === null ? \"\" : (composer.drafts[conversationId] ?? \"\");\n\n  const typing = useTyping(\n    {\n      topic: conversationId === null ? \"\" : conversationTopic(conversationId),\n      identity: { userId: host?.identity.userId ?? \"\" },\n    },\n    { enabled: conversationId !== null && host !== null },\n  );\n\n  const setValue = useCallback(\n    (next: string) => {\n      if (conversationId === null) return;\n      session?.update(current => ({\n        ...current,\n        drafts: { ...current.drafts, [conversationId]: next },\n      }));\n    },\n    [conversationId, session],\n  );\n\n  return {\n    value,\n    setValue,\n    additions,\n    add: (item) => {\n      if (conversationId !== null) session?.update(current => ({\n        ...current,\n        additions: {\n          ...current.additions,\n          [conversationId]: [\n            ...(current.additions[conversationId] ?? []).filter(existing => existing.id !== item.id),\n            item,\n          ],\n        },\n      }));\n    },\n    removeAddition: (id) => {\n      if (conversationId !== null) session?.update(current => ({\n        ...current,\n        additions: {\n          ...current.additions,\n          [conversationId]: (current.additions[conversationId] ?? []).filter(item => item.id !== id),\n        },\n      }));\n    },\n    canSend: (value.trim().length > 0 || additions.length > 0) && conversationId !== null && host !== null,\n    send: () => {\n      if (host === null || conversationId === null || session === null) return;\n      const content = [value.trim(), ...additions.map(item => item.content ?? \"\")].filter(Boolean).join(\"\\n\\n\");\n      const attachments = additions.flatMap(item => item.attachment ? [item.attachment] : []);\n      if (content.length === 0 && attachments.length === 0) return;\n      const draft: DraftMessage = {\n        conversationId,\n        content,\n        attachments,\n        ...(replyTo !== null ? { replyToId: replyTo.id } : {}),\n      };\n      host.engine.send(draft);\n      // Clear the draft only AFTER the outbox has taken ownership. The outbox\n      // has already persisted it, so the text is safe before it leaves here.\n      session.update(current => ({\n        ...current,\n        drafts: { ...current.drafts, [conversationId]: \"\" },\n        replies: { ...current.replies, [conversationId]: null },\n        additions: { ...current.additions, [conversationId]: [] },\n      }));\n      typing.stopTyping();\n    },\n    onKeystroke: typing.onKeystroke,\n    replyTo,\n    setReplyTo,\n  };\n}\n\nexport interface UseTypistsResult {\n  /** Ready-made label: \"Ana is typing…\". `null` when nobody is. */\n  label: string | null;\n  userIds: readonly UserId[];\n}\n\nexport function useTypists(\n  conversationId: ConversationId | null,\n  participants: readonly UserSummary[],\n): UseTypistsResult {\n  const host = useMessagingHost();\n  const typing = useTyping(\n    {\n      topic: conversationId === null ? \"\" : conversationTopic(conversationId),\n      identity: { userId: host?.identity.userId ?? \"\" },\n      // READ-ONLY. This label and `useComposer` sit on the SAME topic, which is\n      // one channel carrying ONE presence entry per key — so exactly one of\n      // them publishes, and it is the composer that actually knows whether this\n      // user is typing. Publishing here would overwrite that on every heartbeat.\n      publish: false,\n    },\n    { enabled: conversationId !== null && host !== null },\n  );\n\n  const selfId = host?.identity.userId;\n  const others = typing.typists.filter((typist) => {\n    const userId = typist.state[\"userId\"];\n    return typeof userId === \"string\" && userId !== selfId;\n  });\n  const names = others.map((typist) => {\n    const userId = typist.state[\"userId\"];\n    const match = participants.find((participant) => participant.userId === userId);\n    return match?.displayName ?? \"Someone\";\n  });\n\n  return {\n    label: formatTypists(names),\n    userIds: others.flatMap((typist) => {\n      const userId = typist.state[\"userId\"];\n      return typeof userId === \"string\" ? [userId as UserId] : [];\n    }),\n  };\n}\n\nexport function useOnlineUserIds(conversationId: ConversationId | null): ReadonlySet<string> {\n  const host = useMessagingHost();\n  const presence = usePresence<{ userId: string }>(\n    {\n      topic: conversationId === null ? \"\" : conversationTopic(conversationId),\n      // READ-ONLY, for the same reason: `useComposer`'s typing presence already\n      // puts this user in the roster under this key with their `userId`, and a\n      // second publisher on one entry just fights it.\n      presence: { publish: false, state: { userId: host?.identity.userId ?? \"\" } },\n    },\n    { enabled: conversationId !== null && host !== null },\n  );\n  return useMemo(\n    () => new Set(presence.members.map((member) => member.state.userId).filter(Boolean)),\n    [presence.members],\n  );\n}\n\nexport interface UseMessagingAiResult {\n  available: readonly AiCapability[];\n  isRunning: boolean;\n  /**\n   * The answer as it arrives, while `isRunning`. A surface renders THIS, not a\n   * skeleton: a placeholder that sits until a run finishes is a spinner\n   * standing in for an answer. Empty string until the first chunk lands.\n   */\n  partialText: string;\n  /** Which capability is running (or produced `result`). */\n  activeCapability: AiCapability | null;\n  result: AiResult | null;\n  error: string | null;\n  run: (capability: AiCapability, args?: { instruction?: string }) => void;\n  clear: () => void;\n}\n\n\nexport function useMessagingAi(conversationId: ConversationId | null): UseMessagingAiResult {\n  const host = useMessagingHost();\n  const conversation = useConversation(conversationId);\n  const [isRunning, setRunning] = useState(false);\n  const [partialText, setPartialText] = useState(\"\");\n  const [activeCapability, setActiveCapability] = useState<AiCapability | null>(\n    null,\n  );\n  const [result, setResult] = useState<AiResult | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const abortRef = useRef<AbortController | null>(null);\n\n  useEffect(\n    () => () => {\n      abortRef.current?.abort();\n    },\n    [],\n  );\n\n  const ai = host?.ai ?? null;\n\n  return {\n    available: ai?.available() ?? [],\n    isRunning,\n    partialText,\n    activeCapability,\n    result,\n    error,\n    clear: () => {\n      setResult(null);\n      setError(null);\n      setPartialText(\"\");\n      setActiveCapability(null);\n    },\n    run: (capability, args = {}) => {\n      if (ai === null || conversationId === null) return;\n      abortRef.current?.abort();\n      const controller = new AbortController();\n      abortRef.current = controller;\n      setRunning(true);\n      setError(null);\n      setResult(null);\n      setPartialText(\"\");\n      setActiveCapability(capability);\n      const base = {\n        conversationId,\n        messages: conversation.messages,\n        participants: conversation.participants,\n        context: {\n          conversationType: conversation.summary?.conversation.type,\n          conversationName: conversation.summary?.displayName,\n          conversationCreatedAt: conversation.summary?.conversation.createdAt,\n          unreadCount: conversation.summary?.unreadCount,\n          isMuted: conversation.summary?.isMuted,\n          readerUserId: host?.identity.userId || undefined,\n        },\n        signal: controller.signal,\n        // Live progress. Aborted runs stop painting immediately — a cancelled\n        // answer must not keep growing on screen.\n        onText: (text: string) => {\n          if (!controller.signal.aborted) setPartialText(text);\n        },\n      };\n      const call = (): Promise<AiResult> => {\n        switch (capability) {\n          case \"catchUp\":\n            return ai.catchMeUp({\n              ...base,\n              // \"What did I miss\" is about the UNREAD tail. Sending the whole\n              // window made this capability a second Summarize.\n              since: unreadCutoff(\n                conversation.messages,\n                conversation.summary?.unreadCount ?? 0,\n              ),\n            });\n          case \"summarize\":\n            return ai.summarize(base);\n          case \"actionItems\":\n            return ai.extractActionItems(base);\n          case \"draftReply\":\n            return ai.draftReply({\n              ...base,\n              ...(args.instruction !== undefined ? { instruction: args.instruction } : {}),\n            });\n          default:\n            return Promise.reject(new Error(`Unknown capability ${String(capability)}`));\n        }\n      };\n      call()\n        .then((next) => {\n          if (!controller.signal.aborted) setResult(next);\n        })\n        .catch((cause: unknown) => {\n          if (controller.signal.aborted) return;\n          setError(String((cause as Error)?.message ?? cause));\n        })\n        .finally(() => {\n          if (!controller.signal.aborted) setRunning(false);\n        });\n    },\n  };\n}\n\nexport interface UseMessageActionResult {\n  choices: ReturnType<import(\"../core/actions\").ActionRegistry[\"choicesFor\"]>;\n  receipt: ActionReceipt | null;\n  isRunning: boolean;\n  execute: (choice: string) => void;\n}\n\n/**\n * An actionable message's chips. The double-click guard is in the registry, not\n * here — this hook only reflects it, which is why two components rendering the\n * same action cannot double-apply it either.\n */\nexport function useMessageAction(message: Message): UseMessageActionResult {\n  const host = useRequiredMessagingHost();\n  // `?? null`, not a bare read: a message can arrive over BROADCAST, and a\n  // payload one field short of the domain shape must degrade to \"no action\",\n  // never take the whole thread down with `undefined.kind`.\n  const action: MessageAction | null = message.action ?? null;\n  const [receipt, setReceipt] = useState<ActionReceipt | null>(() =>\n    action === null\n      ? null\n      : host.actions.receiptFor(action.kind, message.id, host.identity.userId),\n  );\n  const [isRunning, setRunning] = useState(false);\n\n  return {\n    choices: action === null ? [] : host.actions.choicesFor(action),\n    receipt,\n    isRunning,\n    execute: (choice) => {\n      if (action === null || isRunning || receipt !== null) return;\n      setRunning(true);\n      const context: ActionContext = {\n        messageId: message.id,\n        actorId: host.identity.userId,\n        // The active organization, else the organization the message lives in.\n        organizationId: host.identity.organizationId ?? message.organizationId,\n        choice,\n      };\n      host.actions\n        .execute(action, context)\n        .then(setReceipt)\n        .catch((cause: unknown) => {\n          setReceipt({\n            kind: action.kind,\n            messageId: message.id,\n            actorId: host.identity.userId,\n            outcome: \"declined\",\n            label: \"Could not complete\",\n            settledAt: new Date().toISOString(),\n            detail: String((cause as Error)?.message ?? cause),\n          });\n        })\n        .finally(() => setRunning(false));\n    },\n  };\n}\n","/**\n * Display formatting. In the package because every consumer otherwise rebuilds\n * it slightly differently and the inbox and the thread disagree about what\n * \"yesterday\" means.\n *\n * Every function takes an explicit `now` so the tests do not depend on the\n * clock, and none of them touches `Intl` with an implicit locale — a package\n * that silently formats in the build machine's locale is a bug that only shows\n * up for users in other timezones.\n */\n\nimport { formatRelativeTime } from \"@ai-matrx/kit/format\";\n\nimport type { Message, UserId, UserSummary } from \"./types\";\n\nconst MINUTE = 60_000;\nconst HOUR = 60 * MINUTE;\nconst DAY = 24 * HOUR;\n\nexport function isSameDay(a: Date, b: Date): boolean {\n  return (\n    a.getFullYear() === b.getFullYear() &&\n    a.getMonth() === b.getMonth() &&\n    a.getDate() === b.getDate()\n  );\n}\n\n/** Compact stamp for a conversation row: `9:41 AM`, `Yesterday`, `Mar 4`. */\nexport function formatConversationTime(\n  isoString: string | null,\n  now: number = Date.now(),\n  locale?: string,\n): string {\n  if (isoString === null) return \"\";\n  const parsed = Date.parse(isoString);\n  if (!Number.isFinite(parsed)) return \"\";\n  const then = new Date(parsed);\n  const today = new Date(now);\n  if (isSameDay(then, today)) {\n    return then.toLocaleTimeString(locale, { hour: \"numeric\", minute: \"2-digit\" });\n  }\n  const yesterday = new Date(now - DAY);\n  if (isSameDay(then, yesterday)) return \"Yesterday\";\n  if (now - parsed < 7 * DAY) return then.toLocaleDateString(locale, { weekday: \"short\" });\n  return then.toLocaleDateString(locale, { month: \"short\", day: \"numeric\" });\n}\n\n/** The stamp under a bubble. */\nexport function formatMessageTime(\n  isoString: string,\n  locale?: string,\n): string {\n  const parsed = Date.parse(isoString);\n  if (!Number.isFinite(parsed)) return \"\";\n  return new Date(parsed).toLocaleTimeString(locale, {\n    hour: \"numeric\",\n    minute: \"2-digit\",\n  });\n}\n\n/** The separator between day groups in a thread. */\nexport function formatDateSeparator(\n  isoString: string,\n  now: number = Date.now(),\n  locale?: string,\n): string {\n  const parsed = Date.parse(isoString);\n  if (!Number.isFinite(parsed)) return \"\";\n  const then = new Date(parsed);\n  const today = new Date(now);\n  if (isSameDay(then, today)) return \"Today\";\n  if (isSameDay(then, new Date(now - DAY))) return \"Yesterday\";\n  if (then.getFullYear() === today.getFullYear()) {\n    return then.toLocaleDateString(locale, { month: \"long\", day: \"numeric\" });\n  }\n  return then.toLocaleDateString(locale, {\n    year: \"numeric\",\n    month: \"long\",\n    day: \"numeric\",\n  });\n}\n\n// `getInitials` and `avatarPaletteIndex` moved to `@ai-matrx/kit/format` on\n// 2026-09-07 (duplication census H1): both were byte-for-byte duplicated in\n// `@ai-matrx/meet`, and while two packages claimed them no host twin had a\n// correct owner to point at. Nothing is re-exported from here — import\n// `@ai-matrx/kit/format` directly.\n\n/**\n * Group consecutive messages by the same sender within a window, the way every\n * good chat UI does — one avatar and one name per burst.\n */\nexport interface MessageGroup {\n  readonly senderId: UserId;\n  readonly messages: readonly Message[];\n  readonly dateSeparator: string | null;\n}\n\nexport function groupMessages(\n  messages: readonly Message[],\n  args: {\n    now?: number;\n    windowMs?: number;\n    locale?: string;\n    /** Split audit-principal rows by their effective actor presentation. */\n    actorKey?: (message: Message) => string;\n  } = {},\n): readonly MessageGroup[] {\n  const windowMs = args.windowMs ?? 5 * MINUTE;\n  const now = args.now ?? Date.now();\n  const groups: MessageGroup[] = [];\n  let current:\n    | {\n        senderId: UserId;\n        actorKey: string;\n        messages: Message[];\n        dateSeparator: string | null;\n      }\n    | null = null;\n  let previousDay: string | null = null;\n\n  for (const message of messages) {\n    const actorKey = args.actorKey?.(message) ?? `principal:${message.senderId}`;\n    const day = message.createdAt.slice(0, 10);\n    const startsNewDay = day !== previousDay;\n    previousDay = day;\n\n    const last = current?.messages.at(-1);\n    const withinWindow =\n      last !== undefined &&\n      Math.abs(Date.parse(message.createdAt) - Date.parse(last.createdAt)) <= windowMs;\n\n    if (\n      current !== null &&\n      current.senderId === message.senderId &&\n      current.actorKey === actorKey &&\n      withinWindow &&\n      !startsNewDay\n    ) {\n      current.messages.push(message);\n      continue;\n    }\n    if (current !== null) groups.push(current);\n    current = {\n      senderId: message.senderId,\n      actorKey,\n      messages: [message],\n      dateSeparator: startsNewDay\n        ? formatDateSeparator(message.createdAt, now, args.locale)\n        : null,\n    };\n  }\n  if (current !== null) groups.push(current);\n  return groups;\n}\n\n/** \"Ana is typing…\" / \"Ana and Bo are typing…\" / \"3 people are typing…\" */\nexport function formatTypists(names: readonly string[]): string | null {\n  if (names.length === 0) return null;\n  if (names.length === 1) return `${names[0]} is typing…`;\n  if (names.length === 2) return `${names[0]} and ${names[1]} are typing…`;\n  return `${names.length} people are typing…`;\n}\n\nexport function participantNames(\n  participants: readonly UserSummary[],\n  excluding: UserId,\n): readonly string[] {\n  return participants\n    .filter((participant) => participant.userId !== excluding)\n    .map((participant) => participant.displayName);\n}\n\n/**\n * \"Active now\" / \"Active 5m ago\" — presence, said honestly.\n *\n * THE CASCADE WAS A RELATIVE TIME WEARING A DURATION'S CLOTHES (2026-09-12).\n * Three hand-rolled tiers turned an elapsed millisecond count into `5m ago` /\n * `3h ago` / `2d ago`, which is exactly `formatRelativeTime`'s `short` voice —\n * and this package already depends on kit. A package re-deriving another\n * package's capability ships the duplicate to every consumer of this one.\n *\n * What stays local is the only part that is a PRODUCT decision rather than a\n * formatting one: the two-minute \"Active now\" window, which says presence is\n * live rather than reporting a number nobody acts on.\n */\nexport function formatLastSeen(lastSeenMs: number | null, now: number = Date.now()): string {\n  if (lastSeenMs === null) return \"\";\n  if (now - lastSeenMs < 2 * MINUTE) return \"Active now\";\n  return `Active ${formatRelativeTime(lastSeenMs, { style: \"short\", now })}`;\n}\n","\"use client\";\n\n/**\n * THE DROP-IN SURFACES (R6/R7).\n *\n * `<MessagingInbox />` is the whole product in one element. The paired pieces\n * are exported too, for a host that wants the list in a sidebar and the thread\n * on a route — but composing pages is the host's job, and building a product\n * is not.\n *\n * Every screen here obeys the same three rules: a control is absent or honest\n * (never dead or disabled-looking with no reason); loading is a skeleton of the\n * real thing, never the word \"Loading…\"; and a degraded connection SAYS so\n * rather than quietly showing a stale thread.\n */\n\nimport {\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type KeyboardEvent as ReactKeyboardEvent,\n  type ReactNode,\n} from \"react\";\nimport ReactMarkdown from \"react-markdown\";\nimport remarkBreaks from \"remark-breaks\";\nimport remarkGfm from \"remark-gfm\";\nimport { effectiveActorKey, resolveActor, type ActorPresentation } from \"../core/actor\";\nimport { groupMessages, formatConversationTime, formatMessageTime } from \"../core/format\";\nimport { splitText, summarizeText } from \"../core/references\";\nimport type { AiCapability } from \"../core/ai\";\nimport type {\n  ConversationId,\n  ConversationSummary,\n  Message,\n  UserSummary,\n} from \"../core/types\";\nimport {\n  useComposer,\n  useConversation,\n  useConversations,\n  useMessageAction,\n  useMessagingAi,\n  useOnlineUserIds,\n  useTypists,\n  type UseComposerResult,\n} from \"./hooks\";\nimport {\n  Avatar,\n  ConversationSkeleton,\n  DeliveryTick,\n  EmptyState,\n  ReferenceCard,\n  TypingDots,\n  AgentTag,\n  UnreadableReference,\n} from \"./parts\";\nimport { useMessagingHost, useRequiredMessagingHost } from \"./provider\";\nimport {\n  ChevronLeftIcon,\n  CloseIcon,\n  PlusIcon,\n  ReplyIcon,\n  SearchIcon,\n  SendIcon,\n  SparklesIcon,\n  UsersIcon,\n} from \"./icons\";\nimport { ErrorBox } from \"@ai-matrx/design-system\";\n\nconst AI_LABELS: Record<AiCapability, string> = {\n  catchUp: \"Catch me up\",\n  summarize: \"Summarize\",\n  actionItems: \"Action items\",\n  draftReply: \"Draft a reply\",\n};\n\n/* ------------------------------------------------------------------ list -- */\n\nexport interface ConversationListProps {\n  onSelect?: (id: ConversationId) => void;\n  onNewConversation?: () => void;\n  className?: string;\n  /** Conversation IDs the host marks as favorites, in display order. */\n  pinnedConversationIds?: readonly string[];\n}\n\nexport function ConversationList(props: ConversationListProps): ReactNode {\n  const {\n    conversations,\n    hasMore,\n    isInitialLoading,\n    loadMore,\n    select,\n    activeConversationId,\n    archiveFilter,\n    setArchiveFilter,\n    archivedCount,\n    loadError,\n    retry,\n  } = useConversations();\n  const RowChrome = useMessagingHost()?.wrapConversationRow ?? null;\n  const [query, setQuery] = useState(\"\");\n  const favoritePageRequestCount = useRef<number | null>(null);\n\n  const showingArchive = archiveFilter === \"archived\";\n\n  /**\n   * The reveal, or `null` when there is nothing to reveal and nothing revealed.\n   *\n   * 🚨 The count is the SERVER's answer for \"how many archived conversations\n   * are there\", and it is capped: `exact: false` renders \"12+\", never a\n   * confident \"12\". A capped number shown as a total is the same lie as a\n   * badge counting rows the list hides. Before the first count lands the label\n   * carries no number at all rather than a placeholder zero.\n   */\n  const archiveReveal = useMemo(() => {\n    if (showingArchive) {\n      return {\n        next: \"active\" as const,\n        label: \"← Back to active conversations\",\n        ariaLabel: \"Hide archived conversations\",\n      };\n    }\n    if (archivedCount === null) return null;\n    if (archivedCount.count === 0) return null;\n    const printed = archivedCount.exact ? `${archivedCount.count}` : `${archivedCount.count}+`;\n    return {\n      next: \"archived\" as const,\n      label: `Archived (${printed})`,\n      ariaLabel: \"Show archived conversations\",\n    };\n  }, [showingArchive, archivedCount]);\n\n  const visible = useMemo(() => {\n    const needle = query.trim().toLowerCase();\n    if (needle.length === 0) return conversations;\n    return conversations.filter(\n      (item) =>\n        item.displayName.toLowerCase().includes(needle) ||\n        (item.lastMessageContent ?? \"\").toLowerCase().includes(needle),\n    );\n  }, [conversations, query]);\n\n  const loadNextPage = (): void => {\n    if (favoritePageRequestCount.current === conversations.length) return;\n    favoritePageRequestCount.current = conversations.length;\n    loadMore();\n  };\n\n  const hasUnloadedFavorites = (props.pinnedConversationIds ?? []).some(\n    (id) => !conversations.some((item) => String(item.conversation.id) === id),\n  );\n  useEffect(() => {\n    // Load one page at a time until the requested pins appear or the current\n    // archive-filtered reader is exhausted. A page is requested only once for\n    // each loaded-row count, so rendering cannot fan out duplicate reads.\n    if (\n      !hasUnloadedFavorites ||\n      !hasMore ||\n      isInitialLoading ||\n      loadError !== null ||\n      favoritePageRequestCount.current === conversations.length\n    ) {\n      return;\n    }\n    loadNextPage();\n  }, [\n    conversations,\n    hasMore,\n    hasUnloadedFavorites,\n    isInitialLoading,\n    loadError,\n    loadMore,\n    loadNextPage,\n  ]);\n\n  // Resolve favorites against the current reader result so search and archive\n  // filtering keep their existing authority. IDs absent from this page never\n  // become empty or stale favorite tiles.\n  const { favoriteItems, otherPinnedItems, unpinnedItems } = useMemo(() => {\n    const visibleById = new Map<string, ConversationSummary>(\n      visible.map((item) => [String(item.conversation.id), item] as const),\n    );\n    const pinnedItems = (props.pinnedConversationIds ?? [])\n      .map((id) => visibleById.get(id))\n      .filter((item): item is ConversationSummary => item !== undefined);\n    const uniquePinnedItems = Array.from(\n      new Map(pinnedItems.map((item) => [item.conversation.id, item] as const)).values(),\n    ).sort((left, right) => {\n      const byRecency = Date.parse(right.sortAt) - Date.parse(left.sortAt);\n      return Number.isNaN(byRecency) || byRecency === 0\n        ? String(left.conversation.id).localeCompare(String(right.conversation.id))\n        : byRecency;\n    });\n    const pinnedIds = new Set(uniquePinnedItems.map((item) => item.conversation.id));\n    return {\n      favoriteItems: uniquePinnedItems.slice(0, 3),\n      otherPinnedItems: uniquePinnedItems.slice(3),\n      unpinnedItems: visible.filter((item) => !pinnedIds.has(item.conversation.id)),\n    };\n  }, [visible, props.pinnedConversationIds]);\n\n  const selectItem = (item: ConversationSummary): void => {\n    select(item.conversation.id);\n    props.onSelect?.(item.conversation.id);\n  };\n\n  const wrapRow = (item: ConversationSummary, row: ReactNode): ReactNode =>\n    RowChrome !== null ? <RowChrome conversation={item}>{row}</RowChrome> : row;\n\n  return (\n    <div className={`mx-msg__list${props.className !== undefined ? ` ${props.className}` : \"\"}`}>\n      <div className=\"mx-msg__search\">\n        <SearchIcon style={{ color: \"var(--mx-msg-text-faint)\" }} />\n        <input\n          type=\"search\"\n          value={query}\n          placeholder=\"Search conversations\"\n          aria-label=\"Search conversations\"\n          onChange={(event) => setQuery(event.target.value)}\n        />\n        {props.onNewConversation !== undefined ? (\n          <button\n            type=\"button\"\n            className=\"mx-msg__button mx-msg__button--ghost\"\n            style={{ minWidth: 36, minHeight: 36 }}\n            onClick={props.onNewConversation}\n            aria-label=\"New conversation\"\n          >\n            <PlusIcon />\n          </button>\n        ) : null}\n      </div>\n\n      {/* THE ARCHIVED-ITEMS LAW (Arman, 2026-09-09 —\n          common-docs/policies/archived-items.md): archived conversations are\n          hidden by default and ONE click away. Before this the package had no\n          read side for them at all: `setConversationFlags` could archive a\n          conversation and nothing in the package — no filter, no parameter, no\n          affordance — could ever show it again.\n\n          The control is offered only when it would DO something: while hiding,\n          when there is at least one archived conversation to reveal; while\n          showing, always, so the way back is never missing. A button that\n          changes nothing is a dead end, not an affordance. */}\n      {archiveReveal !== null ? (\n        <div className=\"mx-msg__list-archive\">\n          <button\n            type=\"button\"\n            className=\"mx-msg__chip\"\n            onClick={() => setArchiveFilter(archiveReveal.next)}\n            aria-label={archiveReveal.ariaLabel}\n          >\n            {archiveReveal.label}\n          </button>\n        </div>\n      ) : null}\n\n      <div className=\"mx-msg__scroll\">\n        {isInitialLoading ? (\n          <ConversationSkeleton />\n        ) : loadError !== null && visible.length === 0 ? (\n          // A failed read resolves to the failure — never a skeleton forever,\n          // never \"No conversations yet\" (RC-B12 round 11). ErrorBox is the\n          // design-system error slot: the host fills it with its menu.\n          <ReadFailureBox\n            title=\"Couldn't load your conversations\"\n            message={loadError}\n            operation=\"List your conversations\"\n            onRetry={retry}\n          />\n        ) : visible.length === 0 ? (\n          <EmptyState\n            title={\n              query.length > 0\n                ? \"No matches\"\n                : showingArchive\n                  ? \"No archived conversations\"\n                  : \"No conversations yet\"\n            }\n            body={\n              query.length > 0\n                ? \"Try a different name or word.\"\n                : showingArchive\n                  ? \"Archiving a conversation moves it here.\"\n                  : \"Start one and it will appear here.\"\n            }\n          />\n        ) : (\n          <>\n            {favoriteItems.length > 0 ? (\n              <ul className=\"mx-msg__favorites\" aria-label=\"Favorite conversations\">\n                {favoriteItems.map((item) => {\n                  const row = (\n                    <ConversationFavorite\n                      summary={item}\n                      isActive={item.conversation.id === activeConversationId}\n                      onSelect={() => selectItem(item)}\n                    />\n                  );\n                  return (\n                    <li key={item.conversation.id}>\n                      {wrapRow(item, row)}\n                    </li>\n                  );\n                })}\n              </ul>\n            ) : null}\n            <ul className=\"mx-msg__rows\">\n              {[...otherPinnedItems, ...unpinnedItems].map((item) => {\n              const row = (\n                <ConversationRow\n                  summary={item}\n                  isActive={item.conversation.id === activeConversationId}\n                  onSelect={() => selectItem(item)}\n                />\n              );\n              return (\n                <li key={item.conversation.id}>\n                  {/* App chrome — a right-click menu, typically. It WRAPS the\n                      package's row; it never replaces it. */}\n                  {wrapRow(item, row)}\n                </li>\n              );\n              })}\n            </ul>\n          </>\n        )}\n        {hasMore && !isInitialLoading ? (\n          <button\n            type=\"button\"\n            className=\"mx-msg__chip\"\n            style={{ margin: \"8px auto\", display: \"block\" }}\n            onClick={loadNextPage}\n          >\n            Load older conversations\n          </button>\n        ) : null}\n      </div>\n    </div>\n  );\n}\n\nfunction ConversationFavorite(props: {\n  summary: ConversationSummary;\n  isActive: boolean;\n  onSelect: () => void;\n}): ReactNode {\n  const { summary } = props;\n  return (\n    <button\n      type=\"button\"\n      className=\"mx-msg__favorite\"\n      aria-current={props.isActive}\n      aria-label={`Open favorite conversation with ${summary.displayName}`}\n      onClick={props.onSelect}\n    >\n      <Avatar\n        name={summary.displayName}\n        imageUrl={summary.displayImageUrl}\n        seed={summary.conversation.id}\n      />\n      <span className=\"mx-msg__favorite-name\">{summary.displayName}</span>\n    </button>\n  );\n}\n\nfunction ConversationRow(props: {\n  summary: ConversationSummary;\n  isActive: boolean;\n  onSelect: () => void;\n}): ReactNode {\n  const { summary } = props;\n  return (\n    <button\n      type=\"button\"\n      className=\"mx-msg__row\"\n      aria-current={props.isActive}\n      onClick={props.onSelect}\n    >\n      <Avatar\n        name={summary.displayName}\n        imageUrl={summary.displayImageUrl}\n        seed={summary.conversation.id}\n      />\n      <span className=\"mx-msg__row-body\">\n        <span className=\"mx-msg__row-top\">\n          <span className=\"mx-msg__row-name\">{summary.displayName}</span>\n          <span className=\"mx-msg__row-time\">\n            {formatConversationTime(summary.lastMessageAt)}\n          </span>\n        </span>\n        <span className=\"mx-msg__row-preview\">\n          {/* A ```matrx fence collapses to its human label here, exactly as it\n              does in a notification — it never reaches a preview as raw JSON. */}\n          <span>{summarizeText(summary.lastMessageContent ?? \"\", 90) || \"No messages yet\"}</span>\n          {summary.unreadCount > 0 ? (\n            <span className=\"mx-msg__badge\" aria-label={`${summary.unreadCount} unread`}>\n              {summary.unreadCount > 99 ? \"99+\" : summary.unreadCount}\n            </span>\n          ) : null}\n        </span>\n      </span>\n    </button>\n  );\n}\n\n/* ---------------------------------------------------------------- thread -- */\n\nexport interface ConversationViewProps {\n  conversationId: ConversationId | null;\n  onBack?: () => void;\n  className?: string;\n  /** Hide package chrome when a containing workspace already owns the title. */\n  showHeader?: boolean;\n  /** Hide conversation AI controls on a surface that deliberately does not offer them. */\n  showAi?: boolean;\n  /** Let a host inject its canonical textarea chrome without taking composer behavior. */\n  renderComposerInput?: (props: ComposerInputRenderProps) => ReactNode;\n}\n\nexport interface ComposerInputRenderProps {\n  readonly additions: UseComposerResult[\"additions\"];\n  readonly add: UseComposerResult[\"add\"];\n  readonly removeAddition: UseComposerResult[\"removeAddition\"];\n  readonly value: string;\n  readonly disabled: boolean;\n  readonly canSend: boolean;\n  readonly placeholder: string;\n  readonly onChange: (value: string) => void;\n  readonly onKeyDown: (event: ReactKeyboardEvent<HTMLTextAreaElement>) => void;\n  readonly onSubmit: () => void;\n}\n\nexport function ConversationView(props: ConversationViewProps): ReactNode {\n  const { conversationId } = props;\n  const host = useMessagingHost();\n  const conversation = useConversation(conversationId);\n  const typists = useTypists(conversationId, conversation.participants);\n  const online = useOnlineUserIds(conversationId);\n  const composer = useComposer(conversationId);\n  const ai = useMessagingAi(conversationId);\n  const scrollRef = useRef<HTMLDivElement | null>(null);\n  const selfId = host?.identity.userId ?? \"\";\n\n  const messages = conversation.messages;\n  const lastId = messages.at(-1)?.id ?? null;\n\n  // Stick to the bottom on new messages, but only when the reader was ALREADY\n  // near the bottom — yanking someone out of history they are reading is the\n  // rudest bug in chat.\n  useEffect(() => {\n    const node = scrollRef.current;\n    if (node === null) return;\n    const distance = node.scrollHeight - node.scrollTop - node.clientHeight;\n    if (distance < 240) node.scrollTop = node.scrollHeight;\n  }, [lastId]);\n\n  if (conversationId === null) {\n    return (\n      <div className={`mx-msg__thread${props.className !== undefined ? ` ${props.className}` : \"\"}`}>\n        <EmptyState\n          title=\"Pick a conversation\"\n          body=\"Your messages, mentions, and agent replies live here.\"\n        />\n      </div>\n    );\n  }\n\n  const others = conversation.participants.filter(\n    (participant) => participant.userId !== selfId,\n  );\n  const anyOnline = others.some((participant) => online.has(participant.userId));\n\n  return (\n    <div className={`mx-msg__thread${props.className !== undefined ? ` ${props.className}` : \"\"}`}>\n      {props.showHeader !== false ? <header className=\"mx-msg__header\">\n        {props.onBack !== undefined ? (\n          <button\n            type=\"button\"\n            className=\"mx-msg__button mx-msg__button--ghost\"\n            style={{ minWidth: 36, minHeight: 36 }}\n            onClick={props.onBack}\n            aria-label=\"Back to conversations\"\n          >\n            <ChevronLeftIcon />\n          </button>\n        ) : null}\n        <Avatar\n          name={conversation.summary?.displayName ?? \"Conversation\"}\n          imageUrl={conversation.summary?.displayImageUrl ?? null}\n          seed={conversationId}\n          online={anyOnline}\n          small\n        />\n        <span style={{ minWidth: 0 }}>\n          <span className=\"mx-msg__header-title\">\n            {conversation.summary?.displayName ?? \"Conversation\"}\n          </span>\n          <span className=\"mx-msg__header-subtitle\">\n            {typists.label ??\n              (conversation.summary?.conversation.type === \"direct\"\n                ? anyOnline\n                  ? \"Active now\"\n                  : \"\"\n                : `${conversation.participants.length} members`)}\n          </span>\n        </span>\n        <span className=\"mx-msg__header-actions\">\n          {conversation.summary?.conversation.type !== \"direct\" ? (\n            <span\n              className=\"mx-msg__button mx-msg__button--ghost\"\n              style={{ minWidth: 36, minHeight: 36 }}\n              aria-label={`${conversation.participants.length} members`}\n            >\n              <UsersIcon />\n            </span>\n          ) : null}\n        </span>\n      </header> : null}\n\n      {/* The AI bar renders ONLY the capabilities this host actually\n          configured — an unconfigured capability is absent, never a dead\n          button that fails when pressed. */}\n      {props.showAi !== false && ai.available.length > 0 ? (\n        <div className=\"mx-msg__ai-bar\">\n          {ai.available.map((capability) => (\n            <button\n              key={capability}\n              type=\"button\"\n              className=\"mx-msg__chip\"\n              disabled={ai.isRunning}\n              onClick={() => ai.run(capability)}\n            >\n              <SparklesIcon style={{ marginRight: 4, verticalAlign: \"-0.12em\" }} />\n              {AI_LABELS[capability]}\n            </button>\n          ))}\n        </div>\n      ) : null}\n\n      {/* A run the user is WATCHING shows the answer arriving, never a\n          placeholder standing in for one. The skeleton survives only for the\n          gap before the first chunk, where there is genuinely nothing yet —\n          and it says which job is running while it waits. */}\n      {props.showAi !== false && ai.isRunning ? (\n        <p className=\"mx-msg__ai-output\" aria-busy=\"true\" aria-live=\"polite\">\n          {ai.partialText.length > 0 ? (\n            ai.partialText\n          ) : (\n            <>\n              <span className=\"mx-msg__ai-output-label\">\n                {ai.activeCapability !== null\n                  ? `${AI_LABELS[ai.activeCapability]}…`\n                  : \"Working…\"}\n              </span>\n              <span\n                className=\"mx-msg__skeleton\"\n                style={{ display: \"block\", height: 11, width: \"72%\" }}\n              />\n            </>\n          )}\n        </p>\n      ) : props.showAi !== false && ai.error !== null ? (\n        <p className=\"mx-msg__ai-output\" style={{ color: \"var(--mx-msg-danger)\" }}>\n          {ai.error}\n        </p>\n      ) : props.showAi !== false && ai.result !== null ? (\n        <p className=\"mx-msg__ai-output\">\n          {ai.result.text}\n          <button\n            type=\"button\"\n            className=\"mx-msg__button mx-msg__button--ghost\"\n            style={{ minWidth: 28, minHeight: 28, float: \"right\" }}\n            onClick={ai.clear}\n            aria-label=\"Dismiss\"\n          >\n            <CloseIcon />\n          </button>\n        </p>\n      ) : null}\n\n      <div className=\"mx-msg__scroll\" ref={scrollRef}>\n        {conversation.isLoading ? (\n          <ConversationSkeleton rows={4} />\n        ) : conversation.unavailable ? (\n          <EmptyState\n            title=\"Conversation unavailable\"\n            body=\"It doesn't exist, or you aren't a member of it.\"\n          />\n        ) : conversation.error !== null && messages.length === 0 ? (\n          <ReadFailureBox\n            title=\"Couldn't load this conversation\"\n            message={conversation.error.message || \"Check your connection, then open it again.\"}\n            operation=\"Open this conversation\"\n          />\n        ) : messages.length === 0 ? (\n          <EmptyState title=\"No messages yet\" body=\"Say something to get started.\" />\n        ) : (\n          <div className=\"mx-msg__messages\">\n            {conversation.hasMoreOlder ? (\n              <button\n                type=\"button\"\n                className=\"mx-msg__chip\"\n                style={{ margin: \"4px auto 12px\", display: \"block\" }}\n                onClick={conversation.loadOlder}\n              >\n                Load earlier messages\n              </button>\n            ) : null}\n            {groupMessages(messages, { actorKey: effectiveActorKey }).map((group) => {\n              const first = group.messages[0];\n              if (first === undefined) return null;\n              const sender =\n                conversation.participants.find(\n                  (participant) => participant.userId === group.senderId,\n                ) ?? null;\n              const actor = resolveActor(first, sender);\n              const isMine = group.senderId === selfId && !actor.isAgent;\n              return (\n                <div key={first.id}>\n                  {group.dateSeparator !== null ? (\n                    <div className=\"mx-msg__day\">{group.dateSeparator}</div>\n                  ) : null}\n                  <MessageGroupView\n                    allMessages={messages}\n                    showAuthor={conversation.summary?.conversation.type !== \"direct\"}\n                    messages={group.messages}\n                    actor={actor}\n                    isMine={isMine}\n                    onRetry={conversation.retry}\n                    onReply={composer.setReplyTo}\n                    failedEntryIdByClientId={\n                      new Map(\n                        conversation.pending.map((entry) => [entry.clientMessageId, entry.id]),\n                      )\n                    }\n                  />\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n\n      <div className=\"mx-msg__typing\" aria-live=\"polite\">\n        {typists.label !== null ? (\n          <>\n            <TypingDots />\n            {typists.label}\n          </>\n        ) : null}\n      </div>\n\n      <ComposerView\n        composer={composer}\n        disabled={false}\n        {...(props.renderComposerInput !== undefined\n          ? { renderInput: props.renderComposerInput }\n          : {})}\n      />\n    </div>\n  );\n}\n\nfunction MessageGroupView(props: {\n  allMessages: readonly Message[];\n  showAuthor: boolean;\n  messages: readonly Message[];\n  actor: ActorPresentation;\n  isMine: boolean;\n  onRetry: (entryId: string) => void;\n  onReply: (message: Message) => void;\n  failedEntryIdByClientId: ReadonlyMap<string, string>;\n}): ReactNode {\n  const first = props.messages[0];\n  if (first === undefined) return null;\n  // The rendered author is the EFFECTIVE actor: an agent acting through a\n  // human's session never wears that human's name or face.\n  const actor = props.actor;\n\n  return (\n    <>\n    <div className=\"mx-msg__group-time\">{formatMessageTime(first.createdAt)}</div>\n    <div className={`mx-msg__group${props.isMine ? \" mx-msg__group--mine\" : \"\"}`}>\n      {props.showAuthor || actor.isAgent ? <Avatar\n        name={actor.displayName}\n        imageUrl={actor.avatarUrl}\n        seed={actor.isAgent ? `agent:${actor.displayName}` : actor.principalUserId}\n        small\n      /> : null}\n      <div className=\"mx-msg__group-body\">\n        {(props.showAuthor && !props.isMine) || actor.isAgent ? (\n          <div className=\"mx-msg__author\">\n            {actor.displayName}\n            {actor.isAgent ? <AgentTag /> : null}\n            {actor.onBehalfOfName !== null ? (\n              <span style={{ fontWeight: 400, color: \"var(--mx-msg-text-faint)\" }}>\n                via {actor.onBehalfOfName}\n              </span>\n            ) : null}\n          </div>\n        ) : null}\n        {props.messages.map((message, index) => (\n          <MessageBubble\n            key={message.id}\n            message={message}\n            replyTo={props.allMessages.find(parent => parent.id === message.replyToId)}\n            isMine={props.isMine}\n            isLast={index === props.messages.length - 1}\n            onRetry={props.onRetry}\n            onReply={props.onReply}\n            failedEntryId={\n              message.clientMessageId !== null\n                ? (props.failedEntryIdByClientId.get(message.clientMessageId) ?? null)\n                : null\n            }\n          />\n        ))}\n      </div>\n    </div>\n    </>\n  );\n}\n\nexport function MessageBubble(props: {\n  message: Message;\n  renderAttachment?: import(\"./provider\").AttachmentRenderer;\n  replyTo?: Message | undefined;\n  isMine: boolean;\n  isLast: boolean;\n  onRetry?: (entryId: string) => void;\n  onReply?: (message: Message) => void;\n  failedEntryId?: string | null;\n}): ReactNode {\n  const { message, isMine } = props;\n  const host = useMessagingHost();\n  const HostReference = host?.renderReference ?? null;\n  const HostFence = host?.renderFence ?? null;\n  const MessageChrome = host?.wrapMessage ?? null;\n\n  if (message.deletedAt !== null) {\n    return <div className=\"mx-msg__bubble mx-msg__bubble--deleted\">Message deleted</div>;\n  }\n\n  const classes = [\n    \"mx-msg__bubble\",\n    isMine ? \"mx-msg__bubble--mine\" : \"\",\n    props.isLast ? \"mx-msg__bubble--tail\" : \"\",\n    message.deliveryState === \"sending\" ? \"mx-msg__bubble--pending\" : \"\",\n    message.deliveryState === \"failed\" ? \"mx-msg__bubble--failed\" : \"\",\n  ]\n    .filter(Boolean)\n    .join(\" \");\n\n  const bubble = (\n    <>\n      <div className={classes} title={formatMessageTime(message.createdAt)}>\n        {message.replyToId !== null ? <blockquote className=\"mx-msg__quoted-reply\">{props.replyTo ? (props.replyTo.deletedAt ? \"Message deleted\" : summarizeText(props.replyTo.content, 180) || \"Attachment\") : \"Earlier message\"}</blockquote> : null}\n        {message.attachments.map(attachment => {\n          const RenderAttachment = props.renderAttachment ?? host?.renderAttachment;\n          return RenderAttachment ? <RenderAttachment key={attachment.fileId} attachment={attachment} /> : <ReferenceCard key={attachment.fileId} reference={{ entityType: \"file\", entityId: attachment.fileId, label: attachment.fileName }} onOpen={host?.openReference ?? null} />;\n        })}\n        {/* Reference fences become CARDS, never a code block of JSON. A host\n            that already renders references everywhere else in its app hands us\n            its renderer rather than showing two treatments of one fence. */}\n        {splitText(message.content).map((segment, index) =>\n          segment.type === \"text\" ? (\n            <div className=\"mx-msg__markdown\" key={index}>\n              <ReactMarkdown remarkPlugins={[remarkGfm, remarkBreaks]}>\n                {segment.value}\n              </ReactMarkdown>\n            </div>\n          ) : segment.type === \"fence\" ? (\n            HostFence !== null ? (\n              <HostFence key={`fence:${index}`} body={segment.body} />\n            ) : (\n              <UnreadableReference key={`fence:${index}`} />\n            )\n          ) : HostReference !== null ? (\n            <HostReference\n              key={`${segment.reference.entityType}:${segment.reference.entityId}`}\n              reference={segment.reference}\n            />\n          ) : (\n            <ReferenceCard\n              key={`${segment.reference.entityType}:${segment.reference.entityId}`}\n              reference={segment.reference}\n              onOpen={host?.openReference ?? null}\n            />\n          ),\n        )}\n        {message.references.map((reference) =>\n          HostReference !== null ? (\n            <HostReference\n              key={`structured:${reference.entityType}:${reference.entityId}`}\n              reference={reference}\n            />\n          ) : (\n            <ReferenceCard\n              key={`structured:${reference.entityType}:${reference.entityId}`}\n              reference={reference}\n              onOpen={host?.openReference ?? null}\n            />\n          ),\n        )}\n        {message.action !== null ? <MessageActionChips message={message} /> : null}\n      </div>\n      <div\n        className={`mx-msg__meta${\n          message.deliveryState === \"failed\" ? \" mx-msg__meta--failed\" : \"\"\n        }`}\n      >\n        <span className=\"mx-msg__message-time\">{props.isLast ? formatMessageTime(message.createdAt) : null}</span>\n        {message.editedAt !== null ? \" · edited\" : null}\n        {isMine ? <DeliveryTick state={message.deliveryState} /> : null}\n        {message.deliveryState === \"failed\" &&\n        props.failedEntryId != null &&\n        props.onRetry !== undefined ? (\n          <button\n            type=\"button\"\n            className=\"mx-msg__chip mx-msg__chip--danger\"\n            style={{ minHeight: 24, padding: \"2px 8px\" }}\n            onClick={() => props.onRetry?.(props.failedEntryId as string)}\n          >\n            Retry\n          </button>\n        ) : null}\n        {props.onReply !== undefined && message.deliveryState !== \"sending\" ? (\n          <button\n            type=\"button\"\n            className=\"mx-msg__button mx-msg__button--ghost mx-msg__message-action\"\n            onClick={() => props.onReply?.(message)}\n            aria-label=\"Reply\"\n          >\n            <ReplyIcon />\n          </button>\n        ) : null}\n      </div>\n    </>\n  );\n\n  // App chrome AROUND the package's bubble — the right-click menu a platform\n  // owes every surface. It cannot replace the bubble, only surround it.\n  return MessageChrome !== null ? (\n    <MessageChrome message={message} isMine={isMine}>\n      {bubble}\n    </MessageChrome>\n  ) : (\n    bubble\n  );\n}\n\n/**\n * An actionable message's chips. An action this build cannot honor renders\n * NOTHING — never a generic button that offers something nobody can deliver.\n */\nexport function MessageActionChips(props: { message: Message }): ReactNode {\n  const host = useRequiredMessagingHost();\n  const action = useMessageAction(props.message);\n  const declared = props.message.action;\n\n  // A host surface for this kind wins over chips — and the version gate is\n  // applied HERE, not by the host: an action at a version this build does not\n  // list renders nothing at all, exactly as it does on the chip path.\n  const renderer = declared === null ? undefined : host.actionRenderers.get(declared.kind);\n  if (declared !== null && renderer !== undefined) {\n    if (!renderer.versions.includes(declared.version)) return null;\n    const Render = renderer.render;\n    return (\n      <Render\n        message={props.message}\n        payload={declared.payload}\n        isOwn={props.message.senderId === host.identity.userId}\n      />\n    );\n  }\n\n  if (action.receipt !== null) {\n    return (\n      <span className=\"mx-msg__receipt\">\n        {action.receipt.label}\n        {action.receipt.outcome === \"already\" ? \" (already done)\" : \"\"}\n      </span>\n    );\n  }\n  if (action.choices.length === 0) return null;\n  return (\n    <div className=\"mx-msg__chips\">\n      {action.choices.map((choice) => (\n        <button\n          key={choice.id}\n          type=\"button\"\n          className={`mx-msg__chip${\n            choice.tone === \"primary\"\n              ? \" mx-msg__chip--primary\"\n              : choice.tone === \"danger\"\n                ? \" mx-msg__chip--danger\"\n                : \"\"\n          }`}\n          disabled={action.isRunning}\n          onClick={() => action.execute(choice.id)}\n        >\n          {choice.label}\n        </button>\n      ))}\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------- composer -- */\n\n/**\n * The standalone composer: it owns its own state. Inside `ConversationView` the\n * VIEW owns it instead (`ComposerView` below) — two `useComposer` instances on\n * one conversation are two independent drafts, two independent reply targets,\n * and — since typing rides presence — two publishers fighting over ONE presence\n * entry, which `@ai-matrx/realtime` warns about by name.\n */\nexport function Composer(props: { conversationId: ConversationId | null }): ReactNode {\n  const composer = useComposer(props.conversationId);\n  return <ComposerView composer={composer} disabled={props.conversationId === null} />;\n}\n\nfunction ComposerView(props: {\n  composer: UseComposerResult;\n  disabled: boolean;\n  renderInput?: (props: ComposerInputRenderProps) => ReactNode;\n}): ReactNode {\n  const composer = props.composer;\n  const textareaRef = useRef<HTMLTextAreaElement | null>(null);\n\n  // Auto-grow, capped by CSS. Reset to `auto` first or the box only ever grows.\n  useEffect(() => {\n    const node = textareaRef.current;\n    if (node === null) return;\n    node.style.height = \"auto\";\n    node.style.height = `${node.scrollHeight}px`;\n  }, [composer.value]);\n\n  return (\n    <div className=\"mx-msg__composer\">\n      {composer.replyTo !== null ? (\n        <div className=\"mx-msg__reply-bar\">\n          <ReplyIcon />\n          <span>{summarizeText(composer.replyTo.content, 70)}</span>\n          <button\n            type=\"button\"\n            className=\"mx-msg__button mx-msg__button--ghost\"\n            style={{ minWidth: 26, minHeight: 26, marginLeft: \"auto\" }}\n            onClick={() => composer.setReplyTo(null)}\n            aria-label=\"Cancel reply\"\n          >\n            <CloseIcon />\n          </button>\n        </div>\n      ) : null}\n      {props.renderInput !== undefined ? (\n        props.renderInput({\n          additions: composer.additions,\n          add: composer.add,\n          removeAddition: composer.removeAddition,\n          value: composer.value,\n          disabled: props.disabled,\n          canSend: composer.canSend,\n          placeholder: \"Write a reply…\",\n          onChange: (value) => {\n            composer.setValue(value);\n            composer.onKeystroke();\n          },\n          onKeyDown: (event) => {\n            // The package still owns its send/newline contract even when the\n            // host supplies the textarea chrome.\n            if (event.key !== \"Enter\" || event.shiftKey) return;\n            const isTouch =\n              typeof globalThis.matchMedia === \"function\" &&\n              globalThis.matchMedia(\"(pointer: coarse)\").matches;\n            if (isTouch) return;\n            event.preventDefault();\n            composer.send();\n          },\n          onSubmit: composer.send,\n        })\n      ) : (\n      <div className=\"mx-msg__composer-row\">\n        <textarea\n          ref={textareaRef}\n          className=\"mx-msg__input\"\n          rows={1}\n          value={composer.value}\n          placeholder=\"Message\"\n          aria-label=\"Message\"\n          disabled={props.disabled}\n          onChange={(event) => {\n            composer.setValue(event.target.value);\n            composer.onKeystroke();\n          }}\n          onKeyDown={(event) => {\n            // Enter sends; Shift+Enter is a newline. On a touch device Enter is\n            // a newline, because the on-screen keyboard has no Shift+Enter.\n            if (event.key !== \"Enter\" || event.shiftKey) return;\n            const isTouch =\n              typeof globalThis.matchMedia === \"function\" &&\n              globalThis.matchMedia(\"(pointer: coarse)\").matches;\n            if (isTouch) return;\n            event.preventDefault();\n            composer.send();\n          }}\n        />\n        <button\n          type=\"button\"\n          className=\"mx-msg__button\"\n          disabled={!composer.canSend}\n          onClick={composer.send}\n          aria-label=\"Send\"\n        >\n          <SendIcon />\n        </button>\n      </div>\n      )}\n    </div>\n  );\n}\n\n/* ----------------------------------------------------------------- inbox -- */\n\nexport interface MessagingInboxProps {\n  /** Start on a specific conversation (e.g. from a route param). */\n  conversationId?: ConversationId | null;\n  onConversationChange?: (id: ConversationId | null) => void;\n  onNewConversation?: () => void;\n  className?: string;\n}\n\n/**\n * THE WHOLE PRODUCT IN ONE ELEMENT — step 2 of the one-hour contract (R7).\n *\n * On a phone the two panes become one pane that swaps, driven by `data-pane`;\n * a 340px sidebar beside a thread on a 390px screen is the layout every chat\n * app gets wrong exactly once.\n */\nexport function MessagingInbox(props: MessagingInboxProps): ReactNode {\n  const host = useMessagingHost();\n  const [selected, setSelected] = useState<ConversationId | null>(props.conversationId ?? null);\n\n  useEffect(() => {\n    if (props.conversationId !== undefined) setSelected(props.conversationId);\n  }, [props.conversationId]);\n\n  if (host === null) {\n    return (\n      <div className={`mx-msg${props.className !== undefined ? ` ${props.className}` : \"\"}`}>\n        <div className=\"mx-msg__list\">\n          <ConversationSkeleton />\n        </div>\n        <div className=\"mx-msg__thread\" />\n      </div>\n    );\n  }\n\n  const choose = (id: ConversationId | null): void => {\n    setSelected(id);\n    props.onConversationChange?.(id);\n  };\n\n  return (\n    <div\n      className={`mx-msg${props.className !== undefined ? ` ${props.className}` : \"\"}`}\n      data-pane={selected === null ? \"list\" : \"thread\"}\n    >\n      <ConversationList\n        onSelect={choose}\n        {...(props.onNewConversation !== undefined\n          ? { onNewConversation: props.onNewConversation }\n          : {})}\n      />\n      <ConversationView conversationId={selected} onBack={() => choose(null)} />\n    </div>\n  );\n}\n\n/**\n * A read that failed, drawn through the design-system error slot (ErrorBox):\n * the host app fills it with its error actions — in AI Matrx, the Alchemy\n * Menu (RC-B12 round 11). Replaces the EmptyState that said \"couldn't load\"\n * in the same grey as \"no messages yet\".\n */\nfunction ReadFailureBox({\n  title,\n  message,\n  operation,\n  onRetry,\n}: {\n  title: string;\n  message: string;\n  operation: string;\n  onRetry?: () => void;\n}): ReactNode {\n  return (\n    <div className=\"mx-msg__empty\" role=\"alert\">\n      <ErrorBox\n        as=\"div\"\n        title={title}\n        message={message}\n        operation={operation}\n        origin=\"messaging\"\n        style={{ color: \"var(--mx-msg-danger)\", fontWeight: 600 }}\n      >\n        {title}\n      </ErrorBox>\n      <p>{message}</p>\n      {onRetry ? (\n        <button type=\"button\" className=\"mx-msg__button mx-msg__button--ghost\" onClick={onRetry}>\n          Try again\n        </button>\n      ) : null}\n    </div>\n  );\n}\n","/**\n * EFFECTIVE-ACTOR RESOLUTION — who a message is FROM, versus who wrote the row.\n *\n * `sender_id` is the AUDIT PRINCIPAL: the session the write happened under. It\n * must never change, and it must never be what the UI renders when an agent\n * acted through a human's session. Otherwise an automated message wears a\n * colleague's face and name — the failure this module exists to prevent (R4\n * puts agents in conversations, which makes it the normal case, not an edge).\n *\n * The effective actor is declared in the message's own metadata by whoever sent\n * it. Nothing here infers an agent from heuristics on the content.\n */\n\nimport type { JsonObject, Message, UserSummary } from \"./types\";\n\nexport interface ActorPresentation {\n  readonly displayName: string;\n  readonly avatarUrl: string | null;\n  /** True when the message was authored by an agent, not the human principal. */\n  readonly isAgent: boolean;\n  /** Set only for an agent: the human whose session it acted under. */\n  readonly onBehalfOfName: string | null;\n  /** The audit principal. Always the row's `sender_id`. Never rewritten. */\n  readonly principalUserId: Message[\"senderId\"];\n}\n\ninterface ActorHint {\n  readonly agentId?: string;\n  readonly agentName?: string;\n  readonly agentAvatarUrl?: string;\n  readonly showPrincipalAttribution: boolean;\n}\n\nfunction readActorHint(metadata: JsonObject): ActorHint | null {\n  const envelope = metadata as Record<string, unknown>;\n  const raw = envelope[\"actor\"];\n\n  if (typeof raw === \"object\" && raw !== null && !Array.isArray(raw)) {\n    const record = raw as Record<string, unknown>;\n    const agentId = record[\"agentId\"] ?? record[\"agent_id\"];\n    if (typeof agentId !== \"string\" || agentId.length === 0) return null;\n    const name = record[\"agentName\"] ?? record[\"agent_name\"];\n    const avatar = record[\"agentAvatarUrl\"] ?? record[\"agent_avatar_url\"];\n    return {\n      agentId,\n      showPrincipalAttribution: true,\n      ...(typeof name === \"string\" && name.length > 0 ? { agentName: name } : {}),\n      ...(typeof avatar === \"string\" && avatar.length > 0 ? { agentAvatarUrl: avatar } : {}),\n    };\n  }\n\n  // Platform review/event writers use the canonical flat actor envelope. The\n  // explicit kind is the authority: a label alone can never relabel a human.\n  const actorKind = envelope[\"actor_kind\"] ?? envelope[\"actorKind\"];\n  if (actorKind !== \"agent\") return null;\n  const id = envelope[\"actor_id\"] ?? envelope[\"actorId\"];\n  const name = envelope[\"actor_label\"] ?? envelope[\"actorLabel\"];\n  const avatar = envelope[\"actor_avatar_url\"] ?? envelope[\"actorAvatarUrl\"];\n  return {\n    showPrincipalAttribution: false,\n    ...(typeof id === \"string\" && id.length > 0 ? { agentId: id } : {}),\n    ...(typeof name === \"string\" && name.length > 0 ? { agentName: name } : {}),\n    ...(typeof avatar === \"string\" && avatar.length > 0 ? { agentAvatarUrl: avatar } : {}),\n  };\n}\n\n/** Stable presentation identity for grouping adjacent messages in the UI. */\nexport function effectiveActorKey(message: Message): string {\n  const hint = readActorHint(message.metadata);\n  if (hint === null) return `principal:${message.senderId}`;\n  return `agent:${hint.agentId ?? hint.agentName ?? \"anonymous\"}`;\n}\n\nexport function resolveActor(\n  message: Message,\n  sender: UserSummary | null,\n): ActorPresentation {\n  const hint = readActorHint(message.metadata);\n  const humanName = sender?.displayName ?? message.senderId;\n\n  if (hint !== null) {\n    return {\n      // An agent NEVER inherits the human's name or avatar. When the agent did\n      // not name itself, it is labeled generically — an honest \"Agent\" beats a\n      // colleague's face on a message they did not write.\n      displayName: hint.agentName ?? \"Agent\",\n      avatarUrl: hint.agentAvatarUrl ?? null,\n      isAgent: true,\n      // The nested envelope explicitly models an agent acting on behalf of a\n      // session principal. Platform event rows use the flat actor envelope as\n      // the complete presentation identity; surfacing their audit writer as\n      // \"via Human\" wrongly re-attaches that person to an automated event.\n      onBehalfOfName: hint.showPrincipalAttribution ? humanName : null,\n      principalUserId: message.senderId,\n    };\n  }\n\n  if (sender?.isAgent === true) {\n    return {\n      displayName: sender.displayName,\n      avatarUrl: sender.avatarUrl,\n      isAgent: true,\n      onBehalfOfName: null,\n      principalUserId: message.senderId,\n    };\n  }\n\n  return {\n    displayName: humanName,\n    avatarUrl: sender?.avatarUrl ?? null,\n    isAgent: false,\n    onBehalfOfName: null,\n    principalUserId: message.senderId,\n  };\n}\n","\"use client\";\n\n/**\n * The small, shared UI parts. They ship WITH the package (THE ALL-INCLUSIVE\n * LAW): a host that has to write its own avatar, delivery tick, or reference\n * card has been handed a kernel, not a product.\n *\n * Every color comes from the token contract; there is no hardcoded color here.\n */\n\nimport { avatarPaletteIndex, getInitials } from \"@ai-matrx/kit/format\";\nimport { AlertIcon, BotIcon, CheckIcon, ClockIcon, DoubleCheckIcon, LinkIcon } from \"./icons\";\nimport type { DeliveryState, MatrxReference, UserSummary } from \"../core/types\";\n\nexport function Avatar(props: {\n  name: string;\n  imageUrl?: string | null;\n  seed?: string;\n  small?: boolean;\n  online?: boolean;\n}): React.ReactElement {\n  const seed = props.seed ?? props.name;\n  const paletteIndex = avatarPaletteIndex(seed);\n  const className = `mx-msg__avatar${props.small === true ? \" mx-msg__avatar--sm\" : \"\"}`;\n  return (\n    <span\n      className={className}\n      style={{ background: `var(--mx-msg-avatar-${paletteIndex})` }}\n      aria-hidden=\"true\"\n    >\n      {props.imageUrl != null && props.imageUrl.length > 0 ? (\n        <img className=\"mx-msg__avatar-img\" src={props.imageUrl} alt=\"\" loading=\"lazy\" />\n      ) : (\n        getInitials(props.name)\n      )}\n      {props.online === true ? <i className=\"mx-msg__presence\" /> : null}\n    </span>\n  );\n}\n\n/**\n * The delivery tick. Every state has a DISTINCT glyph and a distinct label —\n * a spinner that means both \"sending\" and \"failed\" is the lie this prevents.\n */\nexport function DeliveryTick(props: { state: DeliveryState }): React.ReactElement | null {\n  switch (props.state) {\n    case \"sending\":\n      return <ClockIcon aria-label=\"Sending\" role=\"img\" />;\n    case \"sent\":\n      return <CheckIcon aria-label=\"Sent\" role=\"img\" />;\n    case \"delivered\":\n      return <DoubleCheckIcon aria-label=\"Delivered\" role=\"img\" />;\n    case \"read\":\n      return (\n        <DoubleCheckIcon\n          aria-label=\"Read\"\n          role=\"img\"\n          style={{ color: \"var(--mx-msg-accent)\" }}\n        />\n      );\n    case \"failed\":\n      return <AlertIcon aria-label=\"Not sent\" role=\"img\" />;\n    default:\n      return null;\n  }\n}\n\n/**\n * A reference card. NO DEAD ENDS: when the host wi