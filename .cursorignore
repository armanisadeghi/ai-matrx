# Hard-block generated / cache trees from Cursor AI + indexing.
# Cursor already honours .gitignore, but its DEFAULT ignore list only covers
# `.next/` — NOT `.next-preview`, `.next-agent-*`, `.next-codex-*`, etc.
# Parallel agents each invent a NEXT_DISTDIR; without an explicit block those
# dirs (often tens of GB of Turbopack cache) get crawled and freeze the IDE.

# Every Next.js distDir variant (`.next`, `.next-preview`, `.next-agent-*`, …)
.next
.next/
.next*
.next*/

# Other generated / cache trees
.turbo/
.turbo
node_modules/
.vercel/
out/
coverage/
.tsconfig.measure.tmp.json
type-errors/
*.tsbuildinfo

# Ephemeral agent / local scratch
.claude/worktrees/
.matrx/dev-sessions/
.codex/
_armani/
_dev/
temp/
public/cache/

# Build-profile parks (renamed at config load — never source of truth)
app/_admin_build_excluded/
app/_public_build_excluded/
app/_core_build_excluded/
app/_transitional_build_excluded/
app/_popup_build_excluded/
app/_*_build_excluded.stale-*/

# Secrets / env
.env
.env*
!.env.example
.cursor/mcp.json
